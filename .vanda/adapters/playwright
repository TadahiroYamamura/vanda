#!/usr/bin/env node
// vanda のカスタムアダプタ（受け渡しの形は docs/formats.md の「カスタムアダプタ」）。
// Playwright の E2E（web/e2e/**/*.spec.ts）のアノテーションを読む。読み方は組込みの ts のアダプタと同じ:
// test・it・describe から始まる呼び出しの直前のコメント（空行をはさまない）に書き、名前は最後の呼び出しの最初の引数。
// describe（test.describe を含む）の中なら、外側から順に " > " でつなぐ。
//
// 受け渡しの見本として、組込みのものとは別に Node で書く。依存を足さないため、TypeScript は読まず、
// コメント・文字列・テンプレート文字列・正規表現を見分けるだけの字句の読み取りで済ませる。
"use strict";

const fs = require("fs");

const HOOKS = new Set(["beforeEach", "afterEach", "beforeAll", "afterAll", "step"]);
const REGEX_AFTER = new Set(["return", "typeof", "case", "do", "else", "in", "of", "new", "delete", "void", "throw", "await", "yield", "instanceof"]);

const isIdentStart = (c) => /[A-Za-z_$\u0080-￿]/.test(c);
const isIdent = (c) => /[A-Za-z0-9_$\u0080-￿]/.test(c);

// skipTemplate は、テンプレート文字列の中（開きの逆引用符の次の i から）を読み、閉じの逆引用符の次の位置を返す。
function skipTemplate(src, i) {
  while (i < src.length) {
    if (src[i] === "\\") i += 2;
    else if (src[i] === "`") return i + 1;
    else if (src.startsWith("${", i)) i = skipBraces(src, i + 2);
    else i++;
  }
  return src.length;
}

// skipBraces は、${ の中のコード（i から）を読み、対になる } の次の位置を返す。
function skipBraces(src, i) {
  let depth = 1;
  while (i < src.length) {
    const c = src[i];
    if (c === "{") {
      depth++;
      i++;
    } else if (c === "}") {
      depth--;
      i++;
      if (depth === 0) return i;
    } else if (c === "`") {
      i = skipTemplate(src, i + 1);
    } else if (c === "'" || c === '"') {
      let j = i + 1;
      while (j < src.length && src[j] !== c && src[j] !== "\n") j += src[j] === "\\" ? 2 : 1;
      i = j + 1;
    } else {
      i++;
    }
  }
  return src.length;
}

// lex は、字句（kind: i 名前、s 文字列かテンプレート文字列、p 記号、o そのほか）と、行ごとのコメントの中の文と、
// 行ごとにコメントでない字句が始まるかを返す。
function lex(src) {
  const n = src.split("\n").length;
  const comments = new Array(n).fill("");
  const code = new Array(n).fill(false);
  const toks = [];
  let line = 1;
  const add = (t) => {
    toks.push(t);
    code[t.line - 1] = true;
  };
  const regexOK = () => {
    if (toks.length === 0) return true;
    const t = toks[toks.length - 1];
    // < の後の / は、正規表現でなく JSX の閉じのタグ（</p>）とみなす
    if (t.kind === "p") return "(,=:[!&|?{};+-*%>~^".includes(t.text);
    if (t.kind === "i") return REGEX_AFTER.has(t.text);
    return false;
  };
  let i = 0;
  while (i < src.length) {
    const c = src[i];
    if (c === "\n") {
      line++;
      i++;
    } else if (c === " " || c === "\t" || c === "\r") {
      i++;
    } else if (src.startsWith("//", i)) {
      let end = src.indexOf("\n", i);
      if (end < 0) end = src.length;
      comments[line - 1] += " " + src.slice(i + 2, end);
      i = end;
    } else if (src.startsWith("/*", i)) {
      const end = src.indexOf("*/", i + 2);
      const body = end < 0 ? src.slice(i + 2) : src.slice(i + 2, end);
      body.split("\n").forEach((part, k) => {
        comments[line - 1 + k] += " " + part;
      });
      line += body.split("\n").length - 1;
      i = end < 0 ? src.length : end + 2;
    } else if (c === "'" || c === '"') {
      let j = i + 1;
      let text = "";
      while (j < src.length && src[j] !== c && src[j] !== "\n") {
        if (src[j] === "\\" && j + 1 < src.length && src[j + 1] !== "\n") {
          text += src[j + 1];
          j += 2;
          continue;
        }
        text += src[j];
        j++;
      }
      if (src[j] !== c) {
        // 同じ行で閉じない引用符は、JSX の地の文の ' などとみなし、記号として読み進める
        add({ kind: "p", text: c, line, off: i });
        i++;
        continue;
      }
      add({ kind: "s", text, line, off: i });
      i = j + 1;
    } else if (c === "`") {
      const j = skipTemplate(src, i + 1);
      add({ kind: "s", text: src.slice(i + 1, Math.max(i + 1, j - 1)), line, off: i });
      line += src.slice(i, j).split("\n").length - 1;
      i = j;
    } else if (c === "/" && regexOK()) {
      let j = i + 1;
      let inClass = false;
      let closed = false;
      while (j < src.length && src[j] !== "\n") {
        if (src[j] === "\\") {
          j += 2;
          continue;
        }
        if (src[j] === "[") inClass = true;
        else if (src[j] === "]") inClass = false;
        else if (src[j] === "/" && !inClass) {
          j++;
          closed = true;
          break;
        }
        j++;
      }
      if (!closed) {
        add({ kind: "p", text: "/", line, off: i });
        i++;
        continue;
      }
      while (j < src.length && isIdent(src[j])) j++;
      add({ kind: "o", text: src.slice(i, j), line, off: i });
      i = j;
    } else if (isIdentStart(c)) {
      let j = i;
      while (j < src.length && isIdent(src[j])) j++;
      add({ kind: "i", text: src.slice(i, j), line, off: i });
      i = j;
    } else if (/[0-9]/.test(c)) {
      let j = i;
      while (j < src.length && (isIdent(src[j]) || src[j] === ".")) j++;
      add({ kind: "o", text: src.slice(i, j), line, off: i });
      i = j;
    } else {
      add({ kind: "p", text: c, line, off: i });
      i++;
    }
  }
  return { toks, comments, code };
}

// calls は、test・it・describe から始まる呼び出しのつながり（例: test.describe.serial("名前", …)）を返す。
function calls(toks) {
  const match = new Map();
  const stack = [];
  toks.forEach((t, k) => {
    if (t.kind !== "p") return;
    if (t.text === "(") stack.push(k);
    else if (t.text === ")" && stack.length > 0) match.set(stack.pop(), k);
  });
  const out = [];
  toks.forEach((t, j) => {
    if (t.kind !== "i" || !["test", "it", "describe"].includes(t.text)) return;
    if (j > 0 && toks[j - 1].kind === "p" && toks[j - 1].text === ".") return;
    const c = { root: t, members: [t.text], open: -1, close: -1, named: false, name: "" };
    let k = j + 1;
    while (k < toks.length) {
      if (toks[k].kind === "p" && toks[k].text === "." && k + 1 < toks.length && toks[k + 1].kind === "i") {
        c.members.push(toks[k + 1].text);
        k += 2;
        continue;
      }
      if (toks[k].kind === "p" && toks[k].text === "(" && match.has(k)) {
        c.open = k;
        c.close = match.get(k);
        k = c.close + 1;
        continue;
      }
      break;
    }
    if (c.open < 0) return;
    const a = c.open + 1;
    if (a + 1 < toks.length && toks[a].kind === "s" && toks[a + 1].kind === "p" && (toks[a + 1].text === "," || toks[a + 1].text === ")")) {
      c.named = true;
      c.name = toks[a].text;
    }
    c.describe = t.text === "describe" || c.members[1] === "describe";
    c.hook = c.members.slice(1).some((m) => HOOKS.has(m));
    out.push(c);
  });
  return out;
}

function main() {
  const req = JSON.parse(fs.readFileSync(0, "utf8"));
  const src = req.content;
  const rows = src.split("\n");
  const { toks, comments, code } = lex(src);
  const all = calls(toks);
  const byLine = new Map();
  for (const c of all) if (!byLine.has(c.root.line)) byLine.set(c.root.line, c);
  const firstOnLine = new Map();
  for (const t of toks) if (!firstOnLine.has(t.line)) firstOnLine.set(t.line, t.off);

  const names = [];
  const errors = [];
  for (const { line: l } of req.annotations) {
    const at = `${req.path}:${l}: `;
    if (!comments[l - 1].includes("@vanda:")) {
      // 文字列の中などコメントの外の @vanda: は、アノテーションでないと答える（組込みのアダプタと同じく数えない）
      names.push({ line: l, annotation: false });
      continue;
    }
    let m = 0;
    if (!code[l - 1]) {
      for (let k = l + 1; k <= rows.length; k++) {
        if (code[k - 1]) {
          m = k;
          break;
        }
        if (rows[k - 1].trim() === "") break;
      }
    }
    const c = byLine.get(m);
    if (m === 0 || !c || firstOnLine.get(m) !== c.root.off) {
      errors.push(at + "アノテーションが、test・it・describe の呼び出しの直前のコメントにありません。付けたい呼び出しのすぐ上のコメント（空行をはさまない）に移してください");
      continue;
    }
    if (c.hook) {
      errors.push(at + c.members.join(".") + " の直前には、アノテーションを書けません。付けたい test・it・describe の呼び出しのすぐ上のコメントに移してください");
      continue;
    }
    if (!c.named) {
      errors.push(at + c.members.join(".") + " の名前（最初の引数）が、文字列かテンプレート文字列で書いた決まった文字ではありません。名前を、文字列で直接書いてください");
      continue;
    }
    const outer = all
      .filter((d) => d.describe && toks[d.open].off < c.root.off && c.root.off < toks[d.close].off)
      .sort((a, b) => a.open - b.open);
    const bad = outer.find((d) => !d.named);
    if (bad) {
      errors.push(at + `外側の ${bad.members.join(".")}（${bad.root.line} 行目）の名前が、文字列かテンプレート文字列で書いた決まった文字ではありません。describe の名前を、文字列で直接書いてください`);
      continue;
    }
    names.push({ line: l, name: [...outer.map((d) => d.name), c.name].join(" > ") });
  }
  if (errors.length > 0) {
    process.stderr.write(errors.join("\n") + "\n");
    process.exit(1);
  }
  process.stdout.write(JSON.stringify({ names }) + "\n");
}

main();
