# CMD-01、CM-09: 設定の version と、動いている vanda のバージョンを比べる。
# @vanda:evidence config-version-mismatch
# version が動いている vanda と同じなら通り、新しい・古い・ないときはエラーで止まる。
# チェック（vanda check）も、バージョンが合わなければ止まる。
#
# エラーは version の行（1 行目）を指し、書いたバージョンが出る。設定のバージョンが新しければ vanda を上げるよう、古ければ .vanda/ を
# 書き換えるよう知らせる（約束 config-version-mismatch）。移行のコマンドはまだないので、コマンドは案内しない。

exec git init -q -b main

# 同じバージョンなら通る（この後の失敗が、バージョンの比べ方によるものだと言えるようにするため）
cp cases/config-current.toml .vanda/config.toml
expand .vanda/config.toml
exec vanda doctor
commit '(test) チェックの前にコミットする'
exec vanda check .vanda/checks/all.toml

# version が動いている vanda より新しい
cp cases/config-newer.toml .vanda/config.toml
expand .vanda/config.toml
! exec vanda doctor
stderr 'config\.toml:1: .*'$VANDA_VERSION_NEWER
stderr '上げ'
! stderr 'コマンド'
! stderr '(?m)^panic: '
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/all.toml
stderr 'config\.toml'
! stderr '(?m)^panic: '

# version が動いている vanda より古い
cp cases/config-older.toml .vanda/config.toml
expand .vanda/config.toml
! exec vanda doctor
stderr 'config\.toml:1: .*'$VANDA_VERSION_OLDER
stderr '\.vanda/.*書き換え'
! stderr 'コマンド'
! stderr '(?m)^panic: '
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/all.toml
stderr 'config\.toml'
! stderr '(?m)^panic: '

# version がない
cp cases/config-no-version.toml .vanda/config.toml
! exec vanda doctor
stderr 'config\.toml.*\bversion\b'
! stderr '(?m)^panic: '
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/all.toml
stderr 'config\.toml'
! stderr '(?m)^panic: '

-- cases/config-current.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"
-- cases/config-newer.toml --
version = "${VANDA_VERSION_NEWER}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"
-- cases/config-older.toml --
version = "${VANDA_VERSION_OLDER}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"
-- cases/config-no-version.toml --
[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"
-- .vanda/config.toml --
-- .vanda/checks/all.toml --
[[check]]
name = "promise-list-shape"
scope = "all"
-- .vanda/promises.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"
-- .vanda/agreements.toml --
