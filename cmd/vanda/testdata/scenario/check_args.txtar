# CMD-03: vanda check は、審査の設定のファイルを必須の引数で受け取る。既定の審査は持たない。
# @vanda:evidence check-config-required
# @vanda:evidence check-base-required-for-story
# @vanda:evidence check-story-from-commits
# @vanda:evidence story-id-from-trailer
# 範囲を「1 つのストーリー」にする審査を含む設定では、--base も必須。範囲が全部の審査だけなら、渡さなくてよい。

exec git init -q -b main
expand .vanda/config.toml
commit '約束リストを足す' '#1'

# 審査の設定のファイルを渡さない
! exec vanda check
! stderr '(?m)^panic: '

# 渡した審査の設定のファイルがない
! exec vanda check .vanda/checks/no-such.toml
stderr 'no-such\.toml'
! stderr '(?m)^panic: '

# 範囲が全部の審査だけなら、--base なしで通る
exec vanda check .vanda/checks/all.toml

# 範囲を 1 つのストーリーにする審査を含むのに --base がない
! exec vanda check .vanda/checks/story.toml
stderr '--base'
! stderr '(?m)^panic: '

# 範囲が全部の審査と 1 つのストーリーの審査を混ぜても、--base がなければ止まる
! exec vanda check .vanda/checks/mixed.toml
stderr '--base'
! stderr '(?m)^panic: '

# ストーリーは、分かれた点より後のコミットの Story: のトレーラーの ID から決める（subject・本文の ID は数えない）。
# 分かれた点より後にコミットがない（ID が 0 個）と、--story を求めて止まる
exec git checkout -q -b story-2
! exec vanda check .vanda/checks/story.toml --base main
stderr '--story'
! stderr '(?m)^panic: '
exec vanda check .vanda/checks/story.toml --base main --story '#2'

# ID が 1 つなら、それを使って通る
cp cases/note-1.txt note.txt
commit 'メモを足す' '#2'
exec vanda check .vanda/checks/story.toml --base main
exec vanda check .vanda/checks/mixed.toml --base main

# 分かれた点より後のコミットに、トレーラーのないものが混じっても、ID が 1 つなら通る。subject に書いた #9 は数えない
cp cases/note-2.txt note.txt
commit '#9 メモを直す'
exec vanda check .vanda/checks/story.toml --base main

# ID が 2 つ以上だと、--story を求めて止まる。--story を渡せば通る
cp cases/note-3.txt note.txt
commit 'メモを足す' '#3'
! exec vanda check .vanda/checks/story.toml --base main
stderr '--story'
! stderr '(?m)^panic: '
exec vanda check .vanda/checks/story.toml --base main --story '#2'

-- .vanda/config.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"
-- .vanda/checks/all.toml --
[[check]]
name = "promise-list-shape"
scope = "all"
-- .vanda/checks/story.toml --
[[check]]
name = "agreement"
scope = "story"
-- .vanda/checks/mixed.toml --
[[check]]
name = "promise-list-shape"
scope = "all"

[[check]]
name = "agreement"
scope = "story"
-- .vanda/promises.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"
-- .vanda/agreements.toml --
-- cases/note-1.txt --
1
-- cases/note-2.txt --
2
-- cases/note-3.txt --
3
