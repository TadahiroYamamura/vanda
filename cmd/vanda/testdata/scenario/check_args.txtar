# CMD-03: vanda check は、チェックの設定のファイルを必須の引数で受け取る。既定のチェックは持たない。
# @vanda:evidence check-config-required
# @vanda:evidence check-base-required-for-story
# @vanda:evidence check-story-from-commits
# @vanda:evidence story-id-from-trailer
# @vanda:evidence check-base-unused-without-story
# @vanda:evidence check-output-story-id
# スコープを story にするチェックを含む設定では、--base も必須。スコープが all のチェックだけなら、渡さなくてよい。

exec git init -q -b main
expand .vanda/config.toml
commit '約束リストを足す' '#1'

# チェックの設定のファイルを渡さない
! exec vanda check
! stderr '(?m)^panic: '

# 渡したチェックの設定のファイルがない
! exec vanda check .vanda/checks/no-such.toml
stderr 'no-such\.toml'
! stderr '(?m)^panic: '

# スコープが all のチェックだけなら、--base なしで通る
exec vanda check .vanda/checks/all.toml
! stdout '（story'

# スコープが all のチェックだけなら、--base を使わないので、ないブランチを渡しても通る
exec vanda check .vanda/checks/all.toml --base no-such-branch
stdout '^チェック promise-list-shape（all）: 通った$'

# スコープを story にするチェックを含むのに --base がない
! exec vanda check .vanda/checks/story.toml
stderr '--base'
! stderr '(?m)^panic: '

# スコープが all のチェックと 1 つのストーリーのチェックを混ぜても、--base がなければ止まる
! exec vanda check .vanda/checks/mixed.toml
stderr '--base'
! stderr '(?m)^panic: '

# ストーリーは、マージベースより後のコミットの Story: のトレーラーの ID から決める（subject・本文の ID は数えない）。
# マージベースより後にコミットがない（ID が 0 個）と、--story を求めて止まる
exec git checkout -q -b story-2
! exec vanda check .vanda/checks/story.toml --base main
stderr '--story'
! stderr '(?m)^panic: '
exec vanda check .vanda/checks/story.toml --base main --story '#2'

# ID が 1 つなら、それを使って通る。スコープ story の agreement・evidence-present の結果の行には、スコープの後にチェックに使ったストーリーの ID を書く
cp cases/note-1.txt note.txt
commit 'メモを足す' '#2'
exec vanda check .vanda/checks/story.toml --base main
stdout '^チェック agreement（story #2）: 通った$'
exec vanda check .vanda/checks/mixed.toml --base main
stdout '^チェック promise-list-shape（all）: 通った$'
stdout '^チェック agreement（story #2）: 通った$'
stdout '^チェック evidence-present（story #2）: 通った$'

# マージベースより後のコミットに、トレーラーのないものが混じっても、ID が 1 つなら通る。subject に書いた #9 は数えない
cp cases/note-2.txt note.txt
commit '#9 メモを直す'
exec vanda check .vanda/checks/story.toml --base main

# ID が 2 つ以上だと、--story を求めて止まる。--story を渡せば通る
cp cases/note-3.txt note.txt
commit 'メモを足す' '#3'
! exec vanda check .vanda/checks/story.toml --base main
stderr '--story'
! stderr '(?m)^panic: '
exec vanda check .vanda/checks/story.toml --base main --story '#2'
stdout '^チェック agreement（story #2）: 通った$'
exec vanda check .vanda/checks/story.toml --base main --story '#3'
stdout '^チェック agreement（story #3）: 通った$'

-- .vanda/config.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"
-- .vanda/checks/all.toml --
[[check]]
name = "promise-list-shape"
scope = "all"
-- .vanda/checks/story.toml --
[[check]]
name = "agreement"
scope = "story"
-- .vanda/checks/mixed.toml --
[[check]]
name = "promise-list-shape"
scope = "all"

[[check]]
name = "agreement"
scope = "story"

[[check]]
name = "evidence-present"
scope = "story"
-- .vanda/promises.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"
-- .vanda/agreements.toml --
-- cases/note-1.txt --
1
-- cases/note-2.txt --
2
-- cases/note-3.txt --
3
