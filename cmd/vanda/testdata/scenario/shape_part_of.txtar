# CMD-10 約束リストの形: part_of の先が用語としてあり、循環しない。仕様の refines の先が、機能として約束リストにある。
# @vanda:evidence mistakes-reported-with-fix
# 循環していても、vanda は止まらずに回り続けることなく、エラーで止まる（回り続けると go test の時間切れで落ちる）。
#
# part_of は 1 つの ID の文字列として書いた。配列も書けるのかは計画にないため（報告済み）。
# 循環のエラーがどの行を指すかは計画にないので、ファイルと循環する ID のどれかが同じ行に出ることまでを確かめる。

exec git init -q -b main
expand .vanda/config.toml

# part_of の先が用語としてあれば通る
cp cases/part-of-good.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
exec vanda check .vanda/checks/shape.toml

# part_of の先がない
cp cases/part-of-missing.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:10: .*nothing'
! stderr '(?m)^panic: '

# part_of の先が用語でなく機能
cp cases/part-of-feature.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:10: .*task-add'
! stderr '(?m)^panic: '

# part_of が自分を指す
cp cases/part-of-self.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*task-id'
! stderr '(?m)^panic: '

# part_of が 2 つの用語で循環する
cp cases/part-of-cycle-2.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*\b[xy]\b'
! stderr '(?m)^panic: '

# part_of が 3 つの用語で循環する
cp cases/part-of-cycle-3.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*\b[xyz]\b'
! stderr '(?m)^panic: '

# part_of を配列で書く
cp cases/part-of-array.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:10: .*part_of'
! stderr '(?m)^panic: '

# 仕様の refines に仕様の ID を書く
cp cases/refines-spec.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:15: .*task-id-unique'
! stderr '(?m)^panic: '

# 仕様の refines の先がない
cp cases/refines-missing.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:15: .*nothing'
! stderr '(?m)^panic: '

-- .vanda/config.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"

[[layer]]
id = "cli"
name = "CLI"
description = "引数と出力の形"

[[layer]]
id = "db"
name = "DB"
description = "保存"
-- .vanda/checks/shape.toml --
[[check]]
name = "promise-list-shape"
scope = "all"
-- .vanda/agreements.toml --
-- .vanda/promises.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"

[[feature]]
id = "task-add"
name = "タスクの登録"
definition = "タスクを足す"
core = false
refines = ["no-lost-task"]

[[spec]]
id = "task-id-unique"
refines = ["task-add"]
statement = "タスクの ID は重ならない"
rationale = "ID でタスクを指すため"
condition = "いつも"
layers = ["model"]

[[spec.evidence]]
stage = "implementation"
type = "unit-test"
layers = ["model"]
detail = "task_test.go"

[[property]]
id = "no-lost-task"
statement = "登録したタスクは失われない"
-- cases/part-of-good.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"

[[term]]
id = "task-id"
name = "task-id の名前"
definition = "task-id の定義"
part_of = "task"

[[feature]]
id = "task-add"
name = "タスクの登録"
definition = "タスクを足す"
core = false
refines = ["no-lost-task"]

[[spec]]
id = "task-id-unique"
refines = ["task-add"]
statement = "タスクの ID は重ならない"
rationale = "ID でタスクを指すため"
condition = "いつも"
layers = ["model"]

[[spec.evidence]]
stage = "implementation"
type = "unit-test"
layers = ["model"]
detail = "task_test.go"

[[property]]
id = "no-lost-task"
statement = "登録したタスクは失われない"
