# CMD-10 約束リストの形: part_of の先が用語としてあり、循環しない。subjects の先が約束リストにある。
# @vanda:evidence promise-list-part-of
# @vanda:evidence promise-list-subjects-exist
# 循環していても、vanda は止まらずに回り続けることなく、エラーで止まる（回り続けると go test の時間切れで落ちる）。
#
# part_of は 1 つの ID の文字列として書いた。配列も書けるのかは計画にないため（報告済み）。
# 循環のエラーがどの行を指すかは計画にないので、ファイルと循環する ID のどれかが同じ行に出ることまでを確かめる。

exec git init -q -b main
expand .vanda/config.toml

# part_of の先が用語としてあれば通る
cp cases/part-of-good.toml .vanda/promises.toml
commit '(test) 審査の前にコミットする'
exec vanda check .vanda/checks/shape.toml

# part_of の先がない
cp cases/part-of-missing.toml .vanda/promises.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:10: .*nothing'
! stderr '(?m)^panic: '

# part_of の先が用語でなく機能
cp cases/part-of-feature.toml .vanda/promises.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:10: .*task-add'
! stderr '(?m)^panic: '

# part_of が自分を指す
cp cases/part-of-self.toml .vanda/promises.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*task-id'
! stderr '(?m)^panic: '

# part_of が 2 つの用語で循環する
cp cases/part-of-cycle-2.toml .vanda/promises.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*\b[xy]\b'
! stderr '(?m)^panic: '

# part_of が 3 つの用語で循環する
cp cases/part-of-cycle-3.toml .vanda/promises.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*\b[xyz]\b'
! stderr '(?m)^panic: '

# part_of を配列で書く
cp cases/part-of-array.toml .vanda/promises.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:10: .*part_of'
! stderr '(?m)^panic: '

# subjects に約束の ID を書く
cp cases/subjects-claim.toml .vanda/promises.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:14: .*task-id-unique'
! stderr '(?m)^panic: '

# subjects の先がない
cp cases/subjects-missing.toml .vanda/promises.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:14: .*nothing'
! stderr '(?m)^panic: '

-- .vanda/config.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"

[[layer]]
id = "cli"
name = "CLI"
description = "引数と出力の形"

[[layer]]
id = "db"
name = "DB"
description = "保存"
-- .vanda/checks/shape.toml --
[[check]]
name = "promise-list-shape"
scope = "all"
-- .vanda/agreements.toml --
-- .vanda/promises.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"

[[feature]]
id = "task-add"
name = "タスクの登録"
definition = "タスクを足す"
core = false

[[claim]]
id = "task-id-unique"
subjects = ["task", "task-add"]
statement = "タスクの ID は重ならない"
rationale = "ID でタスクを指すため"
condition = "いつも"
layers = ["model"]

[[claim.evidence]]
stage = "implementation"
type = "unit-test"
layers = ["model"]
detail = "task_test.go"
-- cases/part-of-good.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"

[[term]]
id = "task-id"
name = "task-id の名前"
definition = "task-id の定義"
part_of = "task"

[[feature]]
id = "task-add"
name = "タスクの登録"
definition = "タスクを足す"
core = false

[[claim]]
id = "task-id-unique"
subjects = ["task", "task-add"]
statement = "タスクの ID は重ならない"
rationale = "ID でタスクを指すため"
condition = "いつも"
layers = ["model"]

[[claim.evidence]]
stage = "implementation"
type = "unit-test"
layers = ["model"]
detail = "task_test.go"
