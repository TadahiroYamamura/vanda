# CMD-10 承認: エビデンスの本体のファイル（シナリオ、ガードレールの定義、オラクルの定義）も、今の中身を承認していないと止まる。
# @vanda:evidence renamed-file-needs-agreement
# @vanda:evidence deleted-item-needs-agreement
# @vanda:evidence check-agreement-targets
# ファイルは場所と中身のフィンガープリントで見分ける。名前を変えると、古い場所は消したもの、新しい場所は（中身が同じでも）提案中になる。
# 承認済のファイルを写した先も提案中。中身を 1 文字変えると提案中になる。
#
# 承認の対象のファイルは、txtar と tla のアダプタのパターンにマッチするファイル（アノテーションがなくても）と、ガードレールの paths にマッチするファイル。
# go のアダプタのパターンにマッチするファイルは対象にしない。
#
# txtar のファイルの中身は、この台本の区切りとぶつからないよう、行の頭に > を付けて書き、unquote で外す。

exec git init -q -b main
expand .vanda/config.toml
agree .vanda/agreements.toml '#1' term task fp/term-task.json
agree .vanda/agreements.toml '#1' claim task-id-unique fp/claim.json
unquote scenarios/plain.txtar

# エビデンスの本体のファイルのどれにも承認していないと止まる。Go のファイルは対象にしない
commit 'チェックする前にコミットする'
! exec vanda check .vanda/checks/agreement.toml
stderr 'scenarios/task-id\.txtar'
stderr 'scenarios/plain\.txtar'
stderr 'spec/Task\.tla'
stderr 'spec/Helper\.tla'
stderr 'db/schema\.sql'
! stderr 'task_test\.go'
! stderr '(?m)^panic: '

# 承認すると通る
agree .vanda/agreements.toml '#1' file scenarios/task-id.txtar
agree .vanda/agreements.toml '#1' file spec/Task.tla
agree .vanda/agreements.toml '#1' file scenarios/plain.txtar
agree .vanda/agreements.toml '#1' file spec/Helper.tla
agree .vanda/agreements.toml '#1' file db/schema.sql
commit 'チェックする前にコミットする'
exec vanda check .vanda/checks/agreement.toml

# 承認したことのある約束を消すと、消したことを承認するまで止まる
cp .vanda/promises.toml promises-before.toml
cp cases/without-claim.toml .vanda/promises.toml
commit 'チェックする前にコミットする'
! exec vanda check .vanda/checks/agreement.toml
stdout '失敗（1 件）'
stderr '約束 task-id-unique を消したことに、まだ承認していません'
! stderr '(?m)^panic: '
agree -deleted .vanda/agreements.toml '#1' claim task-id-unique
commit 'チェックする前にコミットする'
exec vanda check .vanda/checks/agreement.toml
cp promises-before.toml .vanda/promises.toml
rm promises-before.toml
commit 'チェックする前にコミットする'
exec vanda check .vanda/checks/agreement.toml

# 承認したことのないファイルを消しても、スコープ all では止めない（承認の対象がなかった）
cp cases/never-agreed.txtar scenarios/never-agreed.txtar
commit 'チェックする前にコミットする'
! exec vanda check .vanda/checks/agreement.toml
stderr 'scenarios/never-agreed\.txtar'
rm scenarios/never-agreed.txtar
commit 'チェックする前にコミットする'
exec vanda check .vanda/checks/agreement.toml

# 承認済のファイルを写した先は、中身が同じでも提案中
cp scenarios/plain.txtar scenarios/plain-copy.txtar
commit 'チェックする前にコミットする'
! exec vanda check .vanda/checks/agreement.toml
stderr 'scenarios/plain-copy\.txtar'
! stderr 'scenarios/plain\.txtar'
! stderr '(?m)^panic: '
rm scenarios/plain-copy.txtar
commit 'チェックする前にコミットする'
exec vanda check .vanda/checks/agreement.toml

# ファイルの名前を変えると、古い場所は消したものになり、新しい場所は中身が同じでも提案中になる
mv scenarios/task-id.txtar scenarios/unique-task-id.txtar
commit 'チェックする前にコミットする'
! exec vanda check .vanda/checks/agreement.toml
stdout '失敗（2 件）'
stderr 'scenarios/unique-task-id\.txtar'
stderr '\.vanda/agreements\.toml:[0-9]+: ファイル scenarios/task-id\.txtar を消したことに、まだ承認していません'
! stderr '(?m)^panic: '

# 新しい場所を承認しても、古い場所を消したことを承認するまで止まる
agree .vanda/agreements.toml '#2' file scenarios/unique-task-id.txtar
commit 'チェックする前にコミットする'
! exec vanda check .vanda/checks/agreement.toml
stdout '失敗（1 件）'
stderr '\.vanda/agreements\.toml:[0-9]+: ファイル scenarios/task-id\.txtar を消したことに、まだ承認していません'
agree -deleted .vanda/agreements.toml '#2' file scenarios/task-id.txtar
commit 'チェックする前にコミットする'
exec vanda check .vanda/checks/agreement.toml

# 名前を元に戻すと、元の場所は同じ中身への記録があるので承認済。承認したことのある新しい場所を消したことへの承認を求める
mv scenarios/unique-task-id.txtar scenarios/task-id.txtar
commit 'チェックする前にコミットする'
! exec vanda check .vanda/checks/agreement.toml
stdout '失敗（1 件）'
stderr '\.vanda/agreements\.toml:[0-9]+: ファイル scenarios/unique-task-id\.txtar を消したことに、まだ承認していません'
! stderr 'scenarios/task-id\.txtar'
agree -deleted .vanda/agreements.toml '#2' file scenarios/unique-task-id.txtar
commit 'チェックする前にコミットする'
exec vanda check .vanda/checks/agreement.toml

# もう一度名前を変えると、どちらの場所にも、その状態（中身か、消したこと）への記録があるので通る
mv scenarios/task-id.txtar scenarios/unique-task-id.txtar
commit 'チェックする前にコミットする'
exec vanda check .vanda/checks/agreement.toml

# シナリオの中身を 1 文字変えると止まる
cp cases/task-id-changed.txtar scenarios/unique-task-id.txtar
commit 'チェックする前にコミットする'
! exec vanda check .vanda/checks/agreement.toml
stderr 'scenarios/unique-task-id\.txtar'
! stderr 'spec/Task\.tla'
! stderr 'db/schema\.sql'
! stderr '(?m)^panic: '
agree .vanda/agreements.toml '#2' file scenarios/unique-task-id.txtar
commit 'チェックする前にコミットする'
exec vanda check .vanda/checks/agreement.toml

# オラクルの定義の中身を 1 文字変えると止まる
cp cases/Task-changed.tla spec/Task.tla
commit 'チェックする前にコミットする'
! exec vanda check .vanda/checks/agreement.toml
stderr 'spec/Task\.tla'
! stderr '(?m)^panic: '
agree .vanda/agreements.toml '#2' file spec/Task.tla
commit 'チェックする前にコミットする'
exec vanda check .vanda/checks/agreement.toml

# ガードレールの定義の中身を 1 文字変えると止まる
cp cases/schema-changed.sql db/schema.sql
commit 'チェックする前にコミットする'
! exec vanda check .vanda/checks/agreement.toml
stderr 'db/schema\.sql'
! stderr '(?m)^panic: '
agree .vanda/agreements.toml '#2' file db/schema.sql
commit 'チェックする前にコミットする'
exec vanda check .vanda/checks/agreement.toml

-- .vanda/config.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "Model"
description = "Decisions and state changes"

[[annotation]]
paths = ["scenarios/**/*.txtar"]
adapter = "txtar"
types = ["scenario-test"]
[[annotation]]
paths = ["spec/**/*.tla"]
adapter = "tla"
types = ["model-check"]
[[annotation]]
paths = ["**/*.go"]
adapter = "go"
types = ["unit-test", "cross-check", "random-check", "interface-test", "concurrency-test", "sensor"]
[[guardrail]]
adapter = "file"
paths = ["db/schema.sql"]
-- .vanda/checks/agreement.toml --
[[check]]
name = "agreement"
scope = "all"
-- .vanda/agreements.toml --
-- .vanda/promises.toml --
[[term]]
id = "task"
name = "Task"
definition = "A thing to do"

[[claim]]
id = "task-id-unique"
subjects = ["task"]
statement = "Task IDs are unique"
rationale = "Tasks are referred to by ID"
condition = "always"
layers = ["model"]

[[claim.evidence]]
stage = "implementation"
type = "model-check"
layers = ["model"]
detail = "spec/Task.tla"
-- scenarios/task-id.txtar --
# @vanda:evidence task-id-unique
# Adding two tasks gives them different IDs.
-- cases/never-agreed.txtar --
# A scenario nobody agreed to.
-- cases/without-claim.toml --
[[term]]
id = "task"
name = "Task"
definition = "A thing to do"
-- cases/task-id-changed.txtar --
# @vanda:evidence task-id-unique
# Adding two tasks gives them different IDs!
-- scenarios/plain.txtar --
>exec echo hello
>-- hello.txt --
>hello
-- spec/Helper.tla --
---- MODULE Helper ----
Max(a, b) == IF a > b THEN a ELSE b
====
-- task_test.go --
package task

import "testing"

func TestNothing(t *testing.T) {}
-- spec/Task.tla --
---- MODULE Task ----
\* @vanda:claim task-id-unique
UniqueIds == TRUE
====
-- cases/Task-changed.tla --
---- MODULE Task ----
\* @vanda:claim task-id-unique
UniqueIdz == TRUE
====
-- db/schema.sql --
CREATE TABLE task (id TEXT PRIMARY KEY);
-- cases/schema-changed.sql --
CREATE TABLE tasks (id TEXT PRIMARY KEY);
-- fp/term-task.json --
{"definition":"A thing to do","id":"task","name":"Task"}
-- fp/claim.json --
{"condition":"always","evidence":[{"detail":"spec/Task.tla","layers":["model"],"stage":"implementation","type":"model-check"}],"id":"task-id-unique","layers":["model"],"rationale":"Tasks are referred to by ID","statement":"Task IDs are unique","subjects":["task"]}
