# CMD-10 合意: エビデンスの本体のファイル（シナリオ、ガードレールの定義、オラクルの定義）も、今の中身に合意していないと止まる。
# CM-03: ファイルの指紋は中身そのものから作るので、名前を変えただけなら合意済のまま、中身を 1 文字変えると提案中になる。
#
# 合意の対象のファイルは、txtar と tla のアダプタのパターンに当たるファイル（アノテーションがなくても）と、ガードレールの paths に当たるファイル。
# go のアダプタのパターンに当たるファイルは対象にしない。
#
# txtar のファイルの中身は、この台本の区切りとぶつからないよう、行の頭に > を付けて書き、unquote で外す。

exec git init -q -b main
expand .vanda/config.toml
agree .vanda/agreements.toml '#1' term task fp/term-task.json
agree .vanda/agreements.toml '#1' claim task-id-unique fp/claim.json
unquote scenarios/plain.txtar

# エビデンスの本体のファイルのどれにも合意していないと止まる。Go のファイルは対象にしない
! exec vanda check .vanda/checks/agreement.toml
stdout 'scenarios/task-id\.txtar'
stdout 'scenarios/plain\.txtar'
stdout 'spec/Task\.tla'
stdout 'spec/Helper\.tla'
stdout 'db/schema\.sql'
! stdout 'task_test\.go'
! stderr '(?m)^panic: '

# 合意すると通る
agree .vanda/agreements.toml '#1' file scenarios/task-id.txtar
agree .vanda/agreements.toml '#1' file spec/Task.tla
agree .vanda/agreements.toml '#1' file scenarios/plain.txtar
agree .vanda/agreements.toml '#1' file spec/Helper.tla
agree .vanda/agreements.toml '#1' file db/schema.sql
exec vanda check .vanda/checks/agreement.toml

# ファイルの名前を変えただけなら、合意済のまま
mv scenarios/task-id.txtar scenarios/unique-task-id.txtar
exec vanda check .vanda/checks/agreement.toml

# シナリオの中身を 1 文字変えると止まる
cp cases/task-id-changed.txtar scenarios/unique-task-id.txtar
! exec vanda check .vanda/checks/agreement.toml
stdout 'scenarios/unique-task-id\.txtar'
! stdout 'spec/Task\.tla'
! stdout 'db/schema\.sql'
! stderr '(?m)^panic: '
agree .vanda/agreements.toml '#2' file scenarios/unique-task-id.txtar
exec vanda check .vanda/checks/agreement.toml

# オラクルの定義の中身を 1 文字変えると止まる
cp cases/Task-changed.tla spec/Task.tla
! exec vanda check .vanda/checks/agreement.toml
stdout 'spec/Task\.tla'
! stderr '(?m)^panic: '
agree .vanda/agreements.toml '#2' file spec/Task.tla
exec vanda check .vanda/checks/agreement.toml

# ガードレールの定義の中身を 1 文字変えると止まる
cp cases/schema-changed.sql db/schema.sql
! exec vanda check .vanda/checks/agreement.toml
stdout 'db/schema\.sql'
! stderr '(?m)^panic: '
agree .vanda/agreements.toml '#2' file db/schema.sql
exec vanda check .vanda/checks/agreement.toml

-- .vanda/config.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "Model"
description = "Decisions and state changes"

[[annotation]]
paths = ["scenarios/**/*.txtar"]
adapter = "txtar"

[[annotation]]
paths = ["spec/**/*.tla"]
adapter = "tla"

[[annotation]]
paths = ["**/*.go"]
adapter = "go"

[[guardrail]]
adapter = "file"
paths = ["db/schema.sql"]
-- .vanda/checks/agreement.toml --
[[check]]
name = "agreement"
scope = "all"
-- .vanda/agreements.toml --
-- .vanda/promises.toml --
[[term]]
id = "task"
name = "Task"
definition = "A thing to do"

[[claim]]
id = "task-id-unique"
subjects = ["task"]
statement = "Task IDs are unique"
rationale = "Tasks are referred to by ID"
condition = "always"
layers = ["model"]

[[claim.evidence]]
stage = "test"
type = "model-check"
layers = ["model"]
detail = "spec/Task.tla"
-- scenarios/task-id.txtar --
# @vanda:evidence task-id-unique
# Adding two tasks gives them different IDs.
-- cases/task-id-changed.txtar --
# @vanda:evidence task-id-unique
# Adding two tasks gives them different IDs!
-- scenarios/plain.txtar --
>exec echo hello
>-- hello.txt --
>hello
-- spec/Helper.tla --
---- MODULE Helper ----
Max(a, b) == IF a > b THEN a ELSE b
====
-- task_test.go --
package task

import "testing"

func TestNothing(t *testing.T) {}
-- spec/Task.tla --
---- MODULE Task ----
\* @vanda:claim task-id-unique
UniqueIds == TRUE
====
-- cases/Task-changed.tla --
---- MODULE Task ----
\* @vanda:claim task-id-unique
UniqueIdz == TRUE
====
-- db/schema.sql --
CREATE TABLE task (id TEXT PRIMARY KEY);
-- cases/schema-changed.sql --
CREATE TABLE tasks (id TEXT PRIMARY KEY);
-- fp/term-task.json --
{"definition":"A thing to do","id":"task","name":"Task"}
-- fp/claim.json --
{"condition":"always","evidence":[{"detail":"spec/Task.tla","layers":["model"],"stage":"test","type":"model-check"}],"id":"task-id-unique","layers":["model"],"rationale":"Tasks are referred to by ID","statement":"Task IDs are unique","subjects":["task"]}
