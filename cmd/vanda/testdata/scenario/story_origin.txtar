# CMD-10 コミットのストーリーのチェック: ベースブランチとのマージベースより後の、約束リストを変えたコミットには、ストーリーの ID の Story: のトレーラーがある。
# @vanda:evidence check-story-origin
# マージベースより前のコミットは見ない（履歴を書き換えないと直せないため）。約束リストを変えていないコミットには、ID がなくてよい。
# ID の書き方は、設定に書かなければ #<数>。
#
# コミットのストーリーのチェックは、スコープを story にしても、どのストーリーかを決めない（マージベースより後のコミットを見るだけ）ので、--story は要らない。

exec git init -q -b main
expand .vanda/config.toml
commit '約束リストを足す'

# マージベースより前の、ID のないコミットは見ない
exec git checkout -q -b story-2
exec vanda check .vanda/checks/origin.toml --base main

# 約束リストを変えたコミットに Story: のトレーラーがあれば通る
cp cases/promises-2.toml .vanda/promises.toml
commit '約束の文を変える' '#2'
exec vanda check .vanda/checks/origin.toml --base main

# 約束リスト以外（承認の記録、ほかのファイル）を変えたコミットには、ID がなくてよい
cp cases/note.txt note.txt
cp cases/agreements.toml .vanda/agreements.toml
commit 'メモと承認の記録を変える'
exec vanda check .vanda/checks/origin.toml --base main

# マージベースより後のコミットに、別のストーリーの ID が混じっても、--story なしで行う
cp cases/note-3.txt note.txt
commit 'メモを直す' '#3'
exec vanda check .vanda/checks/origin.toml --base main

# 約束リストを変えたコミットに Story: のトレーラーがないと止まる
cp cases/promises-3.toml .vanda/promises.toml
commit '約束の文をまた変える'
! exec vanda check .vanda/checks/origin.toml --base main
! stderr '(?m)^panic: '

# ID の書き方を設定で変えると、その書き方のトレーラーで通る。subject に書いた #3 は数えない
exec git checkout -q main
exec git checkout -q -b story-proj
cp cases/config-proj.toml .vanda/config.toml
expand .vanda/config.toml
cp cases/promises-2.toml .vanda/promises.toml
commit '約束の文を変える' 'PROJ-12'
exec vanda check .vanda/checks/origin.toml --base main
cp cases/promises-3.toml .vanda/promises.toml
commit '#3 約束の文をまた変える'
! exec vanda check .vanda/checks/origin.toml --base main
! stderr '(?m)^panic: '

-- .vanda/config.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"
-- .vanda/checks/origin.toml --
[[check]]
name = "story-origin"
scope = "story"
-- .vanda/agreements.toml --
-- .vanda/promises.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"
-- cases/promises-2.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がすること"
-- cases/promises-3.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がこれからすること"
-- cases/note.txt --
メモ
-- cases/agreements.toml --
# 中身はチェックに関わらない
-- cases/config-proj.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"

[story]
id_pattern = "PROJ-[0-9]+"
-- cases/note-3.txt --
別のメモ
