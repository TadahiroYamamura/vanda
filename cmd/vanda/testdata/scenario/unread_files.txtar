# CMD-10 読まれていないファイル: .vanda/ にあるのに、設定のどのパターンにもマッチしないファイルがあると止まる。
# @vanda:evidence unread-files-excludes-adapters
# @vanda:evidence check-unread-files
# .vanda/config.toml と .vanda/checks/*.toml と、アダプタの置き場所 .vanda/adapters/ の下は除く。
# パターンの ** は下のディレクトリにもマッチする。

exec git init -q -b main
expand .vanda/config.toml

# 設定・チェックの設定・既定の約束リストと承認の記録だけなら通る
commit '(test) チェックの前にコミットする'
exec vanda check .vanda/checks/unread.toml

# どのパターンにもマッチしない TOML のファイル
cp cases/stray.toml .vanda/stray.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/unread.toml
stderr '\.vanda/stray\.toml'
! stderr '(?m)^panic: '
rm .vanda/stray.toml

# TOML でないファイルも止める
cp cases/notes.md .vanda/notes.md
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/unread.toml
stderr '\.vanda/notes\.md'
! stderr '(?m)^panic: '
rm .vanda/notes.md

# 下のディレクトリのファイル
mkdir .vanda/sub
cp cases/stray.toml .vanda/sub/stray.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/unread.toml
stderr '\.vanda/sub/stray\.toml'
! stderr '(?m)^panic: '
rm .vanda/sub

# アダプタの置き場所 .vanda/adapters/ の下は除く。TOML でも TOML でなくても、入れ子のディレクトリの下でも
mkdir .vanda/adapters/nested/deep
cp cases/adapter.sh .vanda/adapters/story-adapter
cp cases/stray.toml .vanda/adapters/settings.toml
cp cases/adapter.sh .vanda/adapters/nested/deep/md-annotation
commit '(test) チェックの前にコミットする'
exec vanda check .vanda/checks/unread.toml
! stderr 'adapters'

# 名前が似ているだけの場所は除かない
cp cases/stray.toml .vanda/adapters.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/unread.toml
stderr '\.vanda/adapters\.toml'
! stderr '(?m)^panic: '
rm .vanda/adapters.toml
mkdir .vanda/my-adapters
cp cases/adapter.sh .vanda/my-adapters/x
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/unread.toml
stderr '\.vanda/my-adapters/x'
rm .vanda/my-adapters
mkdir .vanda/adapters2
cp cases/adapter.sh .vanda/adapters2/x
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/unread.toml
stderr '\.vanda/adapters2/x'
rm .vanda/adapters2
# .vanda の直下でない adapters は、置き場所ではない
mkdir .vanda/sub/adapters
cp cases/adapter.sh .vanda/sub/adapters/x
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/unread.toml
stderr '\.vanda/sub/adapters/x'
rm .vanda/sub
rm .vanda/adapters

# パターンを ** で書くと、下のディレクトリのファイルにもマッチする
cp cases/config-deep.toml .vanda/config.toml
expand .vanda/config.toml
rm .vanda/promises.toml
mkdir .vanda/promises/a/b
cp cases/promises.toml .vanda/promises/a/b/deep.toml
commit '(test) チェックの前にコミットする'
exec vanda check .vanda/checks/unread.toml

# 既定のファイル名でも、パターンを書いた後はマッチしないので止まる
cp cases/promises.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/unread.toml
stderr '\.vanda/promises\.toml'
! stderr '(?m)^panic: '

-- .vanda/config.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"
-- .vanda/checks/unread.toml --
[[check]]
name = "unread-files"
scope = "all"
-- .vanda/checks/other.toml --
[[check]]
name = "promise-list-shape"
scope = "all"
-- .vanda/agreements.toml --
-- .vanda/promises.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"
-- cases/promises.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"
-- cases/stray.toml --
[[term]]
id = "stray"
name = "どこからも読まれない"
definition = "どのパターンにもマッチしない"
-- cases/notes.md --
メモ
-- cases/adapter.sh --
#!/bin/sh
echo '{"names": []}'
-- cases/config-deep.toml --
version = "${VANDA_VERSION}"
promises = [".vanda/promises/**/*.toml"]

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"
