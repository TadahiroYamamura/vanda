# CMD-10 読まれていないファイル: .vanda/ にあるのに、設定のどのパターンにも当たらないファイルがあると止まる。
# .vanda/config.toml と .vanda/checks/*.toml は除く。パターンの ** は下のディレクトリにも当たる。

exec git init -q -b main
expand .vanda/config.toml

# 設定・審査の設定・既定の約束リストと合意の記録だけなら通る
exec vanda check .vanda/checks/unread.toml

# どのパターンにも当たらない TOML のファイル
cp cases/stray.toml .vanda/stray.toml
! exec vanda check .vanda/checks/unread.toml
stdout '\.vanda/stray\.toml'
! stderr '(?m)^panic: '
rm .vanda/stray.toml

# TOML でないファイルも止める
cp cases/notes.md .vanda/notes.md
! exec vanda check .vanda/checks/unread.toml
stdout '\.vanda/notes\.md'
! stderr '(?m)^panic: '
rm .vanda/notes.md

# 下のディレクトリのファイル
mkdir .vanda/sub
cp cases/stray.toml .vanda/sub/stray.toml
! exec vanda check .vanda/checks/unread.toml
stdout '\.vanda/sub/stray\.toml'
! stderr '(?m)^panic: '
rm .vanda/sub

# パターンを ** で書くと、下のディレクトリのファイルにも当たる
cp cases/config-deep.toml .vanda/config.toml
expand .vanda/config.toml
rm .vanda/promises.toml
mkdir .vanda/promises/a/b
cp cases/promises.toml .vanda/promises/a/b/deep.toml
exec vanda check .vanda/checks/unread.toml

# 既定のファイル名でも、パターンを書いた後は当たらないので止まる
cp cases/promises.toml .vanda/promises.toml
! exec vanda check .vanda/checks/unread.toml
stdout '\.vanda/promises\.toml'
! stderr '(?m)^panic: '

-- .vanda/config.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"
-- .vanda/checks/unread.toml --
[[check]]
name = "unread-files"
scope = "all"
-- .vanda/checks/other.toml --
[[check]]
name = "promise-list-shape"
scope = "all"
-- .vanda/agreements.toml --
-- .vanda/promises.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"
-- cases/promises.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"
-- cases/stray.toml --
[[term]]
id = "stray"
name = "どこからも読まれない"
definition = "どのパターンにも当たらない"
-- cases/notes.md --
メモ
-- cases/config-deep.toml --
version = "${VANDA_VERSION}"
promises = [".vanda/promises/**/*.toml"]

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"
