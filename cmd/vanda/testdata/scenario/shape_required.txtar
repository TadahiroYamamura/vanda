# CMD-10 約束リストの形: 必須の項目がある。
# @vanda:evidence mistakes-reported-with-fix
# 表（term・feature・spec・spec.evidence）ごとに、必須の項目を 1 つずつ消すと止まる。
#
# 項目がないときは、その項目を持つべき表の見出しの行を指す（docs/formats.md）。
# spec の refines・layers・evidence と、evidence の layers は 1 つ以上なので、空でも止まる。
# 省いてよい項目（spec の rationale・condition・flags・guesses、evidence の detail、feature の core）は、全部を省いても通る。

exec git init -q -b main
expand .vanda/config.toml

# 必須の項目がすべてあれば通る
cp cases/valid.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
exec vanda check .vanda/checks/shape.toml

# 省いてよい項目を全部省いても通る
cp cases/optional-omitted.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
exec vanda check .vanda/checks/shape.toml

# term の id がない
cp cases/missing-term-id.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:1: .*\bid\b'
! stderr '(?m)^panic: '

# term の name がない
cp cases/missing-term-name.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:1: .*\bname\b'
! stderr '(?m)^panic: '

# term の definition がない
cp cases/missing-term-definition.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:1: .*\bdefinition\b'
! stderr '(?m)^panic: '

# feature の id がない
cp cases/missing-feature-id.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:6: .*\bid\b'
! stderr '(?m)^panic: '

# feature の name がない
cp cases/missing-feature-name.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:6: .*\bname\b'
! stderr '(?m)^panic: '

# feature の definition がない
cp cases/missing-feature-definition.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:6: .*\bdefinition\b'
! stderr '(?m)^panic: '

# spec の id がない
cp cases/missing-spec-id.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:13: .*\bid\b'
! stderr '(?m)^panic: '

# spec の refines がない
cp cases/missing-spec-refines.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:13: .*\brefines\b'
! stderr '(?m)^panic: '

# spec の statement がない
cp cases/missing-spec-statement.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:13: .*\bstatement\b'
! stderr '(?m)^panic: '

# spec の layers がない
cp cases/missing-spec-layers.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:13: .*\blayers\b'
! stderr '(?m)^panic: '

# spec の evidence がない
cp cases/missing-spec-evidence.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:13: .*\bevidence\b'
! stderr '(?m)^panic: '

# spec.evidence の stage がない
cp cases/missing-spec.evidence-stage.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:21: .*\bstage\b'
! stderr '(?m)^panic: '

# spec.evidence の type がない
cp cases/missing-spec.evidence-type.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:21: .*\btype\b'
! stderr '(?m)^panic: '

# spec.evidence の layers がない
cp cases/missing-spec.evidence-layers.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:21: .*\blayers\b'
! stderr '(?m)^panic: '

# spec の layers が空
cp cases/empty-spec-layers.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:19: .*layers'
! stderr '(?m)^panic: '

# spec.evidence の layers が空
cp cases/empty-evidence-layers.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:24: .*layers'
! stderr '(?m)^panic: '

# spec の refines が空
cp cases/empty-refines.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:15: .*refines'
! stderr '(?m)^panic: '

# spec の evidence が空
cp cases/empty-evidence.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:20: .*evidence'
! stderr '(?m)^panic: '

-- .vanda/config.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"

[[layer]]
id = "cli"
name = "CLI"
description = "引数と出力の形"

[[layer]]
id = "db"
name = "DB"
description = "保存"
-- .vanda/checks/shape.toml --
[[check]]
name = "promise-list-shape"
scope = "all"
-- .vanda/agreements.toml --
-- .vanda/promises.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"

[[feature]]
id = "task-add"
name = "タスクの登録"
definition = "タスクを足す"
core = false
refines = ["no-lost-task"]

[[spec]]
id = "task-id-unique"
refines = ["task-add"]
statement = "タスクの ID は重ならない"
rationale = "ID でタスクを指すため"
condition = "いつも"
layers = ["model"]

[[spec.evidence]]
stage = "implementation"
type = "unit-test"
layers = ["model"]
detail = "task_test.go"

[[property]]
id = "no-lost-task"
statement = "登録したタスクは失われない"
