# CMD-10 約束リストの形: 必須の項目がある。
# 表（term・feature・claim・claim.evidence）ごとに、必須の項目を 1 つずつ消すと止まる。
#
# 行の分からないエラーは、ファイルと ID と項目で場所を示す（監督が決めた形）。ファイルと同じ行に ID と項目が出ることを確かめる。
# claim の subjects・layers・evidence と、evidence の layers は 1 つ以上なので、空でも止まる。
# 省いてよい項目（claim の rationale・condition・flags・guesses、evidence の detail、feature の core）は、全部を省いても通る。

exec git init -q -b main
expand .vanda/config.toml

# 必須の項目がすべてあれば通る
cp cases/valid.toml .vanda/promises.toml
exec vanda check .vanda/checks/shape.toml

# 省いてよい項目を全部省いても通る
cp cases/optional-omitted.toml .vanda/promises.toml
exec vanda check .vanda/checks/shape.toml

# term の id がない
cp cases/missing-term-id.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*\bid\b'
! stderr '(?m)^panic: '

# term の name がない
cp cases/missing-term-name.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*\bname\b'
stderr 'promises\.toml.*\btask\b'
! stderr '(?m)^panic: '

# term の definition がない
cp cases/missing-term-definition.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*\bdefinition\b'
stderr 'promises\.toml.*\btask\b'
! stderr '(?m)^panic: '

# feature の id がない
cp cases/missing-feature-id.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*\bid\b'
! stderr '(?m)^panic: '

# feature の name がない
cp cases/missing-feature-name.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*\bname\b'
stderr 'promises\.toml.*\btask-add\b'
! stderr '(?m)^panic: '

# feature の definition がない
cp cases/missing-feature-definition.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*\bdefinition\b'
stderr 'promises\.toml.*\btask-add\b'
! stderr '(?m)^panic: '

# claim の id がない
cp cases/missing-claim-id.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*\bid\b'
! stderr '(?m)^panic: '

# claim の subjects がない
cp cases/missing-claim-subjects.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*\bsubjects\b'
stderr 'promises\.toml.*\btask-id-unique\b'
! stderr '(?m)^panic: '

# claim の statement がない
cp cases/missing-claim-statement.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*\bstatement\b'
stderr 'promises\.toml.*\btask-id-unique\b'
! stderr '(?m)^panic: '

# claim の layers がない
cp cases/missing-claim-layers.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*\blayers\b'
stderr 'promises\.toml.*\btask-id-unique\b'
! stderr '(?m)^panic: '

# claim の evidence がない
cp cases/missing-claim-evidence.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*\bevidence\b'
stderr 'promises\.toml.*\btask-id-unique\b'
! stderr '(?m)^panic: '

# claim.evidence の stage がない
cp cases/missing-claim.evidence-stage.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*\bstage\b'
stderr 'promises\.toml.*\btask-id-unique\b'
! stderr '(?m)^panic: '

# claim.evidence の type がない
cp cases/missing-claim.evidence-type.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*\btype\b'
stderr 'promises\.toml.*\btask-id-unique\b'
! stderr '(?m)^panic: '

# claim.evidence の layers がない
cp cases/missing-claim.evidence-layers.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*\blayers\b'
stderr 'promises\.toml.*\btask-id-unique\b'
! stderr '(?m)^panic: '

# claim の layers が空
cp cases/empty-claim-layers.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:18: .*layers'
! stderr '(?m)^panic: '

# claim.evidence の layers が空
cp cases/empty-evidence-layers.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:23: .*layers'
! stderr '(?m)^panic: '

# claim の subjects が空
cp cases/empty-subjects.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:14: .*subjects'
! stderr '(?m)^panic: '

# claim の evidence が空
cp cases/empty-evidence.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:19: .*evidence'
! stderr '(?m)^panic: '

-- .vanda/config.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"

[[layer]]
id = "cli"
name = "CLI"
description = "引数と出力の形"

[[layer]]
id = "db"
name = "DB"
description = "保存"
-- .vanda/checks/shape.toml --
[[check]]
name = "promise-list-shape"
scope = "all"
-- .vanda/agreements.toml --
-- .vanda/promises.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"

[[feature]]
id = "task-add"
name = "タスクの登録"
definition = "タスクを足す"
core = false

[[claim]]
id = "task-id-unique"
subjects = ["task", "task-add"]
statement = "タスクの ID は重ならない"
rationale = "ID でタスクを指すため"
condition = "いつも"
layers = ["model"]

[[claim.evidence]]
stage = "test"
type = "unit-test"
layers = ["model"]
detail = "task_test.go"
