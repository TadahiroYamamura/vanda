# CMD-10 約束リストの形: core = true かつ formal = false なら formal_waiver がある。それ以外で formal_waiver を書くと誤り。
# core = true で formal を省けば formal = true、core を省けば core = false、core = false で formal を省けば formal = false とみなす。

exec git init -q -b main
expand .vanda/config.toml

# core を省く、formal を省く、formal_waiver なし なら通る
cp cases/core-omit-formal-omit-waiver-no.toml .vanda/promises.toml
exec vanda check .vanda/checks/shape.toml

# core を省く、formal を省く、formal_waiver あり なら止まる
cp cases/core-omit-formal-omit-waiver-yes.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*(formal_waiver|task-add)'
! stderr '(?m)^panic: '

# core を省く、formal = false、formal_waiver なし なら通る
cp cases/core-omit-formal-false-waiver-no.toml .vanda/promises.toml
exec vanda check .vanda/checks/shape.toml

# core を省く、formal = false、formal_waiver あり なら止まる
cp cases/core-omit-formal-false-waiver-yes.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*(formal_waiver|task-add)'
! stderr '(?m)^panic: '

# core を省く、formal = true、formal_waiver なし なら通る
cp cases/core-omit-formal-true-waiver-no.toml .vanda/promises.toml
exec vanda check .vanda/checks/shape.toml

# core を省く、formal = true、formal_waiver あり なら止まる
cp cases/core-omit-formal-true-waiver-yes.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*(formal_waiver|task-add)'
! stderr '(?m)^panic: '

# core = false、formal を省く、formal_waiver なし なら通る
cp cases/core-false-formal-omit-waiver-no.toml .vanda/promises.toml
exec vanda check .vanda/checks/shape.toml

# core = false、formal を省く、formal_waiver あり なら止まる
cp cases/core-false-formal-omit-waiver-yes.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*(formal_waiver|task-add)'
! stderr '(?m)^panic: '

# core = false、formal = false、formal_waiver なし なら通る
cp cases/core-false-formal-false-waiver-no.toml .vanda/promises.toml
exec vanda check .vanda/checks/shape.toml

# core = false、formal = false、formal_waiver あり なら止まる
cp cases/core-false-formal-false-waiver-yes.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*(formal_waiver|task-add)'
! stderr '(?m)^panic: '

# core = false、formal = true、formal_waiver なし なら通る
cp cases/core-false-formal-true-waiver-no.toml .vanda/promises.toml
exec vanda check .vanda/checks/shape.toml

# core = false、formal = true、formal_waiver あり なら止まる
cp cases/core-false-formal-true-waiver-yes.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*(formal_waiver|task-add)'
! stderr '(?m)^panic: '

# core = true、formal を省く、formal_waiver なし なら通る
cp cases/core-true-formal-omit-waiver-no.toml .vanda/promises.toml
exec vanda check .vanda/checks/shape.toml

# core = true、formal を省く、formal_waiver あり なら止まる
cp cases/core-true-formal-omit-waiver-yes.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*(formal_waiver|task-add)'
! stderr '(?m)^panic: '

# core = true、formal = false、formal_waiver なし なら止まる
cp cases/core-true-formal-false-waiver-no.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*(formal_waiver|task-add)'
! stderr '(?m)^panic: '

# core = true、formal = false、formal_waiver あり なら通る
cp cases/core-true-formal-false-waiver-yes.toml .vanda/promises.toml
exec vanda check .vanda/checks/shape.toml

# core = true、formal = true、formal_waiver なし なら通る
cp cases/core-true-formal-true-waiver-no.toml .vanda/promises.toml
exec vanda check .vanda/checks/shape.toml

# core = true、formal = true、formal_waiver あり なら止まる
cp cases/core-true-formal-true-waiver-yes.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml.*(formal_waiver|task-add)'
! stderr '(?m)^panic: '

-- .vanda/config.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"

[[layer]]
id = "cli"
name = "CLI"
description = "引数と出力の形"

[[layer]]
id = "db"
name = "DB"
description = "保存"
-- .vanda/checks/shape.toml --
[[check]]
name = "promise-list-shape"
scope = "all"
-- .vanda/agreements.toml --
-- .vanda/promises.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"

[[feature]]
id = "task-add"
name = "タスクの登録"
definition = "タスクを足す"
core = false

[[claim]]
id = "task-id-unique"
subjects = ["task", "task-add"]
statement = "タスクの ID は重ならない"
rationale = "ID でタスクを指すため"
condition = "いつも"
layers = ["model"]

[[claim.evidence]]
stage = "test"
type = "unit-test"
layers = ["model"]
detail = "task_test.go"
-- cases/core-omit-formal-omit-waiver-no.toml --
[[term]]
id = "task"
name = "タスク"
