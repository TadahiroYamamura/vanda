# CMD-10 承認: 今の中身がすべて承認済で、フラグ（flags・guesses）が残っていないと通る。
# @vanda:evidence changed-id-is-new
# @vanda:evidence check-agreement-flags-left
# @vanda:evidence check-agreement-targets
# CM-03: フィンガープリントは flags と guesses を除いた中身から作る。同じ中身に 2 つのストーリーが承認しても承認済。約束の ID を変えると提案中。
#
# フィンガープリントの元の JSON（fp/ の下）は、約束リストの項目から手で書いた（キーを名前の順に並べ、空白なし）。

exec git init -q -b main
expand .vanda/config.toml

# 承認していない約束・用語があると止まる
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/agreement.toml
stderr 'promises\.toml.*task-id-unique'
stderr '(?m)promises\.toml.*\btask\b($|[^-])'
! stderr '(?m)^panic: '

# 承認すると通る
agree .vanda/agreements.toml '#1' term task fp/term-task.json
agree .vanda/agreements.toml '#1' claim task-id-unique fp/claim-v1.json
commit '(test) チェックの前にコミットする'
exec vanda check .vanda/checks/agreement.toml

# 承認した後に中身（文）を変えると止まる
cp cases/promises-v2.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/agreement.toml
stderr 'promises\.toml.*task-id-unique'
! stderr '(?m)^panic: '

# 承認したときの中身に戻すと、また通る（承認はフィンガープリントで探すため）
cp cases/promises-v1.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
exec vanda check .vanda/checks/agreement.toml

# 項目の順・空白・引用符だけが違う書き方なら、承認済のまま
cp cases/promises-v1-reformatted.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
exec vanda check .vanda/checks/agreement.toml

# 承認した後に flags だけを立てると、フィンガープリントは変わらないが、フラグが残っているので止まる
cp cases/promises-v1-flags.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/agreement.toml
stderr 'promises\.toml.*(task-id-unique|ai-proposal|flags)'
! stderr '(?m)^panic: '

# 承認した後に guesses だけを書いても、同じく止まる
cp cases/promises-v1-guesses.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/agreement.toml
stderr 'promises\.toml.*(task-id-unique|guesses)'
! stderr '(?m)^panic: '

# 中身を変えて、別のストーリーが今の中身を承認すれば通る。前の承認は履歴として残っていてよい
cp cases/promises-v2.toml .vanda/promises.toml
agree .vanda/agreements.toml '#2' claim task-id-unique fp/claim-v2.json
commit '(test) チェックの前にコミットする'
exec vanda check .vanda/checks/agreement.toml

# 同じ中身に、もう 1 つのストーリーが別に承認しても、承認済のまま
agree .vanda/agreements.toml '#3' claim task-id-unique fp/claim-v2.json
commit '(test) チェックの前にコミットする'
exec vanda check .vanda/checks/agreement.toml

# 約束の ID を変えると、中身が同じでも提案中になる
cp cases/promises-v2-renamed.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/agreement.toml
stderr 'promises\.toml.*task-ids-unique'
! stderr '(?m)^panic: '

-- .vanda/config.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "Model"
description = "Decisions and state changes"
-- .vanda/checks/agreement.toml --
[[check]]
name = "agreement"
scope = "all"
-- .vanda/agreements.toml --
-- .vanda/promises.toml --
[[term]]
id = "task"
name = "Task"
definition = "A thing to do"

[[claim]]
id = "task-id-unique"
subjects = ["task"]
statement = "Task IDs are unique"
rationale = "Tasks are referred to by ID"
condition = "always"
layers = ["model"]

[[claim.evidence]]
stage = "implementation"
type = "unit-test"
layers = ["model"]
detail = "task_test.go"
-- cases/promises-v1.toml --
[[term]]
id = "task"
name = "Task"
definition = "A thing to do"

[[claim]]
id = "task-id-unique"
subjects = ["task"]
statement = "Task IDs are unique"
rationale = "Tasks are referred to by ID"
condition = "always"
layers = ["model"]

[[claim.evidence]]
stage = "implementation"
type = "unit-test"
layers = ["model"]
detail = "task_test.go"
-- cases/promises-v1-reformatted.toml --
[[claim]]
layers    =    [ "model" ]
condition = 'always'
rationale = "Tasks are referred to by ID"
statement = 'Task IDs are unique'
subjects  = [
  "task",
]
id = "task-id-unique"

  [[claim.evidence]]
  type = 'unit-test'
  detail = "task_test.go"
  layers = ['model']
  stage = "implementation"

[[term]]
definition = 'A thing to do'
name="Task"
id="task"
-- cases/promises-v1-flags.toml --
[[term]]
id = "task"
name = "Task"
definition = "A thing to do"

[[claim]]
id = "task-id-unique"
subjects = ["task"]
statement = "Task IDs are unique"
rationale = "Tasks are referred to by ID"
condition = "always"
layers = ["model"]
flags = ["ai-proposal"]

[[claim.evidence]]
stage = "implementation"
type = "unit-test"
layers = ["model"]
detail = "task_test.go"
-- cases/promises-v1-guesses.toml --
[[term]]
id = "task"
name = "Task"
definition = "A thing to do"

[[claim]]
id = "task-id-unique"
subjects = ["task"]
statement = "Task IDs are unique"
rationale = "Tasks are referred to by ID"
condition = "always"
layers = ["model"]
guesses = ["IDs are assigned in order"]

[[claim.evidence]]
stage = "implementation"
type = "unit-test"
layers = ["model"]
detail = "task_test.go"
-- cases/promises-v2.toml --
[[term]]
id = "task"
name = "Task"
definition = "A thing to do"

[[claim]]
id = "task-id-unique"
subjects = ["task"]
statement = "No two tasks share an ID"
rationale = "Tasks are referred to by ID"
condition = "always"
layers = ["model"]

[[claim.evidence]]
stage = "implementation"
type = "unit-test"
layers = ["model"]
detail = "task_test.go"
-- cases/promises-v2-renamed.toml --
[[term]]
id = "task"
name = "Task"
definition = "A thing to do"

[[claim]]
id = "task-ids-unique"
subjects = ["task"]
statement = "No two tasks share an ID"
rationale = "Tasks are referred to by ID"
condition = "always"
layers = ["model"]

[[claim.evidence]]
stage = "implementation"
type = "unit-test"
layers = ["model"]
detail = "task_test.go"
-- fp/term-task.json --
{"definition":"A thing to do","id":"task","name":"Task"}
-- fp/claim-v1.json --
{"condition":"always","evidence":[{"detail":"task_test.go","layers":["model"],"stage":"implementation","type":"unit-test"}],"id":"task-id-unique","layers":["model"],"rationale":"Tasks are referred to by ID","statement":"Task IDs are unique","subjects":["task"]}
-- fp/claim-v2.json --
{"condition":"always","evidence":[{"detail":"task_test.go","layers":["model"],"stage":"implementation","type":"unit-test"}],"id":"task-id-unique","layers":["model"],"rationale":"Tasks are referred to by ID","statement":"No two tasks share an ID","subjects":["task"]}
