# アノテーションの読み取り: 1 つのファイルが 2 つ以上の [[annotation]] のパターンにマッチすると止まる。
# @vanda:evidence annotation-one-rule-per-file

exec git init -q -b main

# マッチするのが 1 つなら通る
cp cases/config-one.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) チェックの前にコミットする'
exec vanda check .vanda/checks/links.toml

# go と、カスタムアダプタの両方にマッチする
chmod 755 .vanda/adapters/names
cp cases/config-two.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr 'task_test\.go'
! stderr '(?m)^panic: '

-- .vanda/checks/links.toml --
[[check]]
name = "annotation-links"
scope = "all"
-- .vanda/agreements.toml --
-- .vanda/promises.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"

[[claim]]
id = "task-id-unique"
subjects = ["task"]
statement = "タスクの ID は重ならない"
layers = ["model"]

[[claim.evidence]]
stage = "implementation"
type = "unit-test"
layers = ["model"]
-- .vanda/adapters/names --
#!/bin/sh
cat >/dev/null
printf '%s' '{"names":[{"line":5,"name":"x"}]}'
-- task_test.go --
package task

import "testing"

// @vanda:evidence task-id-unique
func TestAddKeepsIdsUnique(t *testing.T) {}
-- cases/config-one.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"

[[annotation]]
paths = ["**/*_test.go"]
adapter = "go"
types = ["unit-test", "cross-check", "random-check", "interface-test", "concurrency-test", "sensor"]
-- cases/config-two.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"

[[annotation]]
paths = ["**/*_test.go"]
adapter = "go"
types = ["unit-test", "cross-check", "random-check", "interface-test", "concurrency-test", "sensor"]
[[annotation]]
paths = ["*.go"]
adapter = "names"
types = ["unit-test"]