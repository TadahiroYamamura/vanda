# アノテーションの読み取り: .vanda/adapters/ のアダプタ（.vanda/adapters/ の直下のファイルか、ディレクトリの直下の run）。
# @vanda:evidence annotation-adapter-required
# @vanda:evidence project-adapter-name
# @vanda:evidence project-adapter-overrides-builtin
# @vanda:evidence project-adapter-args-and-cwd
# @vanda:evidence project-adapter-args-only-for-project
# @vanda:evidence project-adapter-not-runnable
# @vanda:evidence adapter-name-unknown
# @vanda:evidence project-adapter-not-annotation
# @vanda:evidence project-adapter-response-errors
# @vanda:evidence project-adapter-failure-reason
# 設定には adapter = "<名前>" と args だけを書く。args はそのまま引数として渡る。
# アダプタが失敗したとき、返したものが JSON として読めないときは、審査が止まる。
# 読むファイルのパターンに当たったのに、アダプタが決まっていないファイルがあると、審査で止まる。
#
# 受け渡しの形は docs/formats.md の「`.vanda/adapters/` のアダプタ」。
# ok は、引数（--mode check）と、標準入力にファイルの場所と行が来ていることを確かめ、決まった名前を返す。

exec git init -q -b main
chmod 755 .vanda/adapters/ok
chmod 755 .vanda/adapters/okdir/run
chmod 755 .vanda/adapters/wrong-line
chmod 755 .vanda/adapters/empty-name
chmod 755 .vanda/adapters/reason
chmod 755 .vanda/adapters/fail
chmod 755 .vanda/adapters/not-json
chmod 755 .vanda/adapters/go
chmod 755 .vanda/adapters/norun/other

# ファイルの形のアダプタに、args が渡り、正しい JSON を返せば通る
cp cases/config-ok.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
exec vanda check .vanda/checks/links.toml

# 引数が違えば、アダプタが失敗する（args が渡っていることの確かめ）
cp cases/config-ok-wrong-args.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr 'ext/a\.ext.*args: --mode other'
! stderr '(?m)^panic: '

# ディレクトリの形のアダプタは、直下の run を動かし、args が渡る
cp cases/config-dir.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
exec vanda check .vanda/checks/links.toml

# 名前で指したアノテーションの ID は、組込みのアダプタと同じく、約束リストとのつながりを審査する
cp cases/config-ok.toml .vanda/config.toml
expand .vanda/config.toml
cp cases/a-no-such.ext ext/a.ext
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr 'ext/a\.ext:1: '
! stderr '(?m)^panic: '
cp cases/a.ext ext/a.ext

# 組込みのアダプタ（go）と同じ名前のアダプタが .vanda/adapters/ にあれば、そちらを使う。
# 組込みの go なら ext/a.ext を Go として読めずに止まるが、.vanda/adapters/go は名前を返すので通る
cp cases/config-go.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
exec vanda check .vanda/checks/links.toml

# 渡していない行の名前を返す
cp cases/config-wrong-line.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr 'ext/a\.ext'
! stderr '(?m)^panic: '

# 空の名前を返す
cp cases/config-empty-name.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr 'ext/a\.ext'
! stderr '(?m)^panic: '

# 0 でない終了コードで終わると、標準エラーに書いた理由がエラーのメッセージに入る
cp cases/config-reason.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr 'ext/a\.ext.*the annotation is misplaced'
! stderr '(?m)^panic: '

# アダプタが失敗する
cp cases/config-fail.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr 'ext/a\.ext'
! stderr '(?m)^panic: '

# アダプタが JSON として読めないものを返す
cp cases/config-not-json.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr 'ext/a\.ext'
! stderr '(?m)^panic: '

# 行ごとに "annotation": false を返した行は、アノテーションとして数えず、書き方が誤っていても（ID が 2 つ）誤りにしない。
# 名前を返した行は、今までどおり確かめる（2 行目は約束リストの用語を指すので通る）
chmod 755 .vanda/adapters/not-annotation
cp cases/two-lines.ext ext/a.ext
cp cases/config-not-annotation.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
exec vanda check .vanda/checks/links.toml

# 名前を返した行は、書き方を確かめる（ID が 2 つで止まる）
chmod 755 .vanda/adapters/both-named
cp cases/config-both-named.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr 'ext/a\.ext:1: '
! stderr '(?m)^panic: '
cp cases/a.ext ext/a.ext

# 誤りになる返し方: 渡した行に何も返さない、同じ行に 2 つ、名前と annotation の両方、annotation に false 以外、名前も annotation もない
chmod 755 .vanda/adapters/no-answer
chmod 755 .vanda/adapters/twice
chmod 755 .vanda/adapters/name-and-false
chmod 755 .vanda/adapters/annotation-true
chmod 755 .vanda/adapters/annotation-string
cp cases/config-no-answer.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr 'ext/a\.ext'
! stderr '(?m)^panic: '
cp cases/config-twice.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr 'ext/a\.ext'
! stderr '(?m)^panic: '
cp cases/config-name-and-false.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr 'ext/a\.ext'
! stderr '(?m)^panic: '
cp cases/config-annotation-true.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr 'ext/a\.ext'
! stderr '(?m)^panic: '
cp cases/config-annotation-string.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr 'ext/a\.ext'
! stderr '(?m)^panic: '
chmod 755 .vanda/adapters/neither
cp cases/config-neither.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr 'ext/a\.ext'
! stderr '(?m)^panic: '

# 名前のアダプタが、中にも .vanda/adapters/ にもない。場所と直し方が出る
cp cases/config-missing.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr '\.vanda/config\.toml.*no-such-adapter'
stderr '\.vanda/adapters/'
stderr 'ください。'
! stderr '(?m)^panic: '

# 実行の権限がない。場所と直し方が出る
cp cases/config-noexec.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr '\.vanda/adapters/noexec'
stderr 'ください。'
! stderr '(?m)^panic: '

# ディレクトリの直下に run がない。場所と直し方が出る
cp cases/config-norun.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr '\.vanda/adapters/norun/run'
stderr 'ください。'
! stderr '(?m)^panic: '

# アダプタの名前に、空・/・\・.・.. は書けない（.vanda/adapters/ の外を指せないように）
cp cases/config-name-empty.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr '\.vanda/config\.toml'
! stderr '(?m)^panic: '
cp cases/config-name-slash.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr '\.vanda/config\.toml.*okdir/run'
! stderr '(?m)^panic: '
cp cases/config-name-backslash.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr '\.vanda/config\.toml'
! stderr '(?m)^panic: '
cp cases/config-name-dot.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr '\.vanda/config\.toml'
! stderr '(?m)^panic: '
cp cases/config-name-dotdot.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr '\.vanda/config\.toml'
! stderr '(?m)^panic: '

# 組込みのアダプタには args を書けない
cp cases/config-builtin-args.toml .vanda/config.toml
expand .vanda/config.toml
rm .vanda/adapters/go
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr '\.vanda/config\.toml.*args'
! stderr '(?m)^panic: '

# command は、ほかの決まっていない項目と同じく誤りになる
cp cases/config-command.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
stderr '\.vanda/config\.toml.*command'
! stderr '(?m)^panic: '

# アダプタを書いていない
cp cases/config-no-adapter.toml .vanda/config.toml
expand .vanda/config.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/links.toml
! stderr '(?m)^panic: '

# パターンに当たるファイルがなければ、アダプタは動かず、通る（上の失敗が ext/a.ext を読んだことによるものだと言えるようにするため）
cp cases/config-fail.toml .vanda/config.toml
expand .vanda/config.toml
rm ext/a.ext
commit '(test) 審査の前にコミットする'
exec vanda check .vanda/checks/links.toml

-- .vanda/config.toml --
-- .vanda/checks/links.toml --
[[check]]
name = "annotation-links"
scope = "all"
-- .vanda/promises.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"
-- .vanda/agreements.toml --
-- ext/a.ext --
@vanda:term task
-- .vanda/adapters/ok --
#!/bin/sh
if [ "$1" != "--mode" ] || [ "$2" != "check" ] || [ $# -ne 2 ]; then
  echo "args: $*" >&2
  exit 8
fi
in=$(cat)
case "$in" in
*'"ext/a.ext"'*) ;;
*) echo "path がない: $in" >&2; exit 9 ;;
esac
case "$in" in
*'"line"'*1*) ;;
*) echo "line がない: $in" >&2; exit 9 ;;
esac
printf '%s' '{"names":[{"line":1,"name":"a の手順"}]}'
-- .vanda/adapters/okdir/run --
#!/bin/sh
if [ "$1" != "--dir" ] || [ $# -ne 1 ]; then
  echo "args: $*" >&2
  exit 8
fi
cat >/dev/null
printf '%s' '{"names":[{"line":1,"name":"a の手順"}]}'
-- .vanda/adapters/go --
#!/bin/sh
cat >/dev/null
printf '%s' '{"names":[{"line":1,"name":".vanda/adapters/ の go"}]}'
-- .vanda/adapters/wrong-line --
#!/bin/sh
cat >/dev/null
printf '%s' '{"names":[{"line":2,"name":"a の手順"}]}'
-- .vanda/adapters/empty-name --
#!/bin/sh
cat >/dev/null
printf '%s' '{"names":[{"line":1,"name":""}]}'
-- .vanda/adapters/reason --
#!/bin/sh
cat >/dev/null
echo 'the annotation is misplaced' >&2
exit 4
-- .vanda/adapters/fail --
#!/bin/sh
exit 3
-- .vanda/adapters/not-json --
#!/bin/sh
cat >/dev/null
echo not-json
-- .vanda/adapters/noexec --
#!/bin/sh
cat >/dev/null
printf '%s' '{"names":[{"line":1,"name":"a の手順"}]}'
-- .vanda/adapters/norun/other --
#!/bin/sh
cat >/dev/null
printf '%s' '{"names":[{"line":1,"name":"a の手順"}]}'
-- cases/a.ext --
@vanda:term task
-- cases/a-no-such.ext --
@vanda:term no-such-id
-- cases/config-ok.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"

[[annotation]]
paths = ["ext/*.ext"]
adapter = "ok"
types = ["unit-test"]
args = ["--mode", "check"]
-- cases/config-ok-wrong-args.toml --
