name = "モデル"
description = "判定と状態の変化"

[[annotation]]
paths = ["ext/*.ext"]
adapter = "go"
types = ["unit-test", "cross-check", "random-check", "interface-test", "concurrency-test", "sensor"]
args = ["--strict"]
-- .vanda/adapters/not-annotation --
