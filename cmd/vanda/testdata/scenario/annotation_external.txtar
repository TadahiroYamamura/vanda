[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"

[[annotation]]
paths = ["ext/*.ext"]
adapter = "norun"
-- cases/config-command.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"

[[annotation]]
paths = ["ext/*.ext"]
command = ["sh", ".vanda/adapters/ok", "--mode", "check"]
-- cases/config-no-adapter.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"

[[annotation]]
paths = ["ext/*.ext"]
-- cases/config-name-empty.toml --
