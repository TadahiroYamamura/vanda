# CMD-10 約束リストの形: ID は英小文字・数字をハイフンでつないだ形で、用語・機能・仕様を通して重複しない。
# @vanda:evidence mistakes-reported-with-fix
# 重複は、表の組み合わせ（同じ表どうし、違う表どうし）を全部回す。分けたファイルをまたいでも重複しない。
# 重複したときは、後のほうの行を指し、前の場所（行）をメッセージに書く。前の場所の書き方は決め打ちしない。ファイルは名前の順に読むものとした（one.toml が前）。

exec git init -q -b main
expand .vanda/config.toml

# 英小文字で始まり、英小文字・数字をハイフンでつないだ ID なら通る
cp cases/good-ids.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
exec vanda check .vanda/checks/shape.toml

# 仕様の ID の形が誤り（upper）
cp cases/bad-id-spec-upper.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:14: '
! stderr '(?m)^panic: '

# 仕様の ID の形が誤り（underscore）
cp cases/bad-id-spec-underscore.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:14: '
! stderr '(?m)^panic: '

# 仕様の ID の形が誤り（leading-hyphen）
cp cases/bad-id-spec-leading-hyphen.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:14: '
! stderr '(?m)^panic: '

# 仕様の ID の形が誤り（trailing-hyphen）
cp cases/bad-id-spec-trailing-hyphen.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:14: '
! stderr '(?m)^panic: '

# 仕様の ID の形が誤り（double-hyphen）
cp cases/bad-id-spec-double-hyphen.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:14: '
! stderr '(?m)^panic: '

# 仕様の ID の形が誤り（space）
cp cases/bad-id-spec-space.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:14: '
! stderr '(?m)^panic: '

# 仕様の ID の形が誤り（non-ascii）
cp cases/bad-id-spec-non-ascii.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:14: '
! stderr '(?m)^panic: '

# 仕様の ID の形が誤り（empty）
cp cases/bad-id-spec-empty.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:14: '
! stderr '(?m)^panic: '

# 仕様の ID の形が誤り（leading-digit）
cp cases/bad-id-spec-leading-digit.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:14: '
! stderr '(?m)^panic: '

# term の ID の形が誤り（upper）
cp cases/bad-id-term-upper.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:2: '
! stderr '(?m)^panic: '

# feature の ID の形が誤り（upper）
cp cases/bad-id-feature-upper.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:7: '
! stderr '(?m)^panic: '

# ID が重複する（term-term）
cp cases/dup-term-term.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:28: .*task.*\b2\b'
! stderr '(?m)^panic: '

# ID が重複する（feature-feature）
cp cases/dup-feature-feature.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:28: .*task-add.*\b7\b'
! stderr '(?m)^panic: '

# ID が重複する（spec-spec）
cp cases/dup-spec-spec.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:28: .*task-id-unique.*\b14\b'
! stderr '(?m)^panic: '

# ID が重複する（term-feature）
cp cases/dup-term-feature.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:28: .*task.*\b2\b'
! stderr '(?m)^panic: '

# ID が重複する（term-spec）
cp cases/dup-term-spec.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:28: .*task.*\b2\b'
! stderr '(?m)^panic: '

# ID が重複する（feature-spec）
cp cases/dup-feature-spec.toml .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:28: .*task-add.*\b7\b'
! stderr '(?m)^panic: '

# 分けたファイルをまたいで ID が重複する
cp cases/config-split.toml .vanda/config.toml
expand .vanda/config.toml
rm .vanda/promises.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'two\.toml:2: .*task.*one\.toml'
! stderr '(?m)^panic: '

-- .vanda/config.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"

[[layer]]
id = "cli"
name = "CLI"
description = "引数と出力の形"

[[layer]]
id = "db"
name = "DB"
description = "保存"
-- .vanda/checks/shape.toml --
[[check]]
name = "promise-list-shape"
scope = "all"
-- .vanda/agreements.toml --
-- .vanda/promises.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"

[[feature]]
id = "task-add"
name = "タスクの登録"
definition = "タスクを足す"
core = false
refines = ["no-lost-task"]

[[spec]]
id = "task-id-unique"
refines = ["task-add"]
statement = "タスクの ID は重ならない"
rationale = "ID でタスクを指すため"
condition = "いつも"
layers = ["model"]

[[spec.evidence]]
stage = "implementation"
type = "unit-test"
layers = ["model"]
detail = "task_test.go"

[[property]]
id = "no-lost-task"
statement = "登録したタスクは失われない"
