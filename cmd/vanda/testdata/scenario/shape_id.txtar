-- cases/config-split.toml --
version = "${VANDA_VERSION}"
promises = [".vanda/promises/*.toml"]

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"

[[layer]]
id = "cli"
name = "CLI"
description = "引数と出力の形"

[[layer]]
