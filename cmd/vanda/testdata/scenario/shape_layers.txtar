# CMD-10 約束リストの形: エビデンスの layers は約束の layers の中にある。約束に書いたどのレイヤーにも、それを確かめるエビデンスが 1 つ以上ある。

exec git init -q -b main
expand .vanda/config.toml

# 約束の 2 つのレイヤーを、別々のエビデンスが確かめれば通る
cp cases/split-ok.toml .vanda/promises.toml
exec vanda check .vanda/checks/shape.toml

# 約束の 2 つのレイヤーを、1 つのエビデンスがまとめて確かめても通る
cp cases/both-ok.toml .vanda/promises.toml
exec vanda check .vanda/checks/shape.toml

# エビデンスの layers に、約束にないレイヤーを書く
cp cases/outside.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:23: .*cli'
! stderr '(?m)^panic: '

# 約束のレイヤーのうち cli を確かめるエビデンスがない
cp cases/uncovered.toml .vanda/promises.toml
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:18: .*\bcli\b'
! stderr '(?m)^panic: '

-- .vanda/config.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"

[[layer]]
id = "cli"
name = "CLI"
description = "引数と出力の形"

[[layer]]
id = "db"
name = "DB"
description = "保存"
-- .vanda/checks/shape.toml --
[[check]]
name = "promise-list-shape"
scope = "all"
-- .vanda/agreements.toml --
-- .vanda/promises.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"

[[feature]]
id = "task-add"
name = "タスクの登録"
definition = "タスクを足す"
core = false

[[claim]]
id = "task-id-unique"
subjects = ["task", "task-add"]
statement = "タスクの ID は重ならない"
rationale = "ID でタスクを指すため"
condition = "いつも"
layers = ["model"]

[[claim.evidence]]
stage = "test"
type = "unit-test"
layers = ["model"]
detail = "task_test.go"
-- cases/split-ok.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"

[[feature]]
id = "task-add"
name = "タスクの登録"
definition = "タスクを足す"
core = false

[[claim]]
id = "task-id-unique"
subjects = ["task", "task-add"]
statement = "タスクの ID は重ならない"
rationale = "ID でタスクを指すため"
condition = "いつも"
layers = ["model", "cli"]

[[claim.evidence]]
stage = "test"
type = "unit-test"
layers = ["model"]
detail = "task_test.go"

[[claim.evidence]]
stage = "test"
type = "scenario-test"
layers = ["cli"]
detail = "task.txtar"
