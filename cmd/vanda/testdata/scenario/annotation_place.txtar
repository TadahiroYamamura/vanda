package task

// Task は利用者がやること。書き方は `@vanda:foo no-such-id` のとおり。
type Task struct{ ID string }

// @vanda:sensor task-id-unique
// 説明: `@vanda:evidence no-such-id` とは書かない
func Add(ids []string, id string) ([]string, error) { return append(ids, id), nil }
