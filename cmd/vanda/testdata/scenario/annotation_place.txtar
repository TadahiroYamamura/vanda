# アノテーションの読み取り: 決まっていない種類と、ID を 2 つ以上書いたものは、どの言語でもその行で止まる。
# ID がない、理由のない internal、1 行に 2 つの `@vanda:` も、どの言語でも止まる。
# 付ける所の決まり: Go は func の宣言の直前のコメントだけ。txtar は最初の -- name -- より前だけを数える（後は中のファイルの中身）。
# 文字列の中の `@vanda:` は数えず、誤りにもしない。
# TLA+ は、次の空行でもコメントでもない行が Name == か Name(...) == でなければ止まる。

exec git init -q -b main
expand .vanda/config.toml
unquote scenarios/add.txtar

# 元のファイルでは通る
exec vanda check .vanda/checks/links.toml

# go で決まっていない種類（foo）を書くと、その行で止まる
cp cases/go-unknown-kind.case task.go
! exec vanda check .vanda/checks/links.toml
stderr 'task\.go:6: .*foo'
! stderr '(?m)^panic: '
cp orig/task.go.orig task.go

# go で 1 つのアノテーションに ID を 2 つ書くと、その行で止まる
cp cases/go-two-ids.case task.go
! exec vanda check .vanda/checks/links.toml
stderr 'task\.go:6: '
! stderr '(?m)^panic: '
cp orig/task.go.orig task.go

# txtar で決まっていない種類（foo）を書くと、その行で止まる
cp cases/txtar-unknown-kind.case scenarios/add.txtar
unquote scenarios/add.txtar
! exec vanda check .vanda/checks/links.toml
stderr 'scenarios/add\.txtar:1: .*foo'
! stderr '(?m)^panic: '
cp orig/add.txtar.orig scenarios/add.txtar
unquote scenarios/add.txtar

# txtar で 1 つのアノテーションに ID を 2 つ書くと、その行で止まる
cp cases/txtar-two-ids.case scenarios/add.txtar
unquote scenarios/add.txtar
! exec vanda check .vanda/checks/links.toml
stderr 'scenarios/add\.txtar:1: '
! stderr '(?m)^panic: '
cp orig/add.txtar.orig scenarios/add.txtar
unquote scenarios/add.txtar

# tla で決まっていない種類（foo）を書くと、その行で止まる
cp cases/tla-unknown-kind.case spec/Task.tla
! exec vanda check .vanda/checks/links.toml
stderr 'spec/Task\.tla:13: .*foo'
! stderr '(?m)^panic: '
cp orig/Task.tla.orig spec/Task.tla

# tla で 1 つのアノテーションに ID を 2 つ書くと、その行で止まる
cp cases/tla-two-ids.case spec/Task.tla
! exec vanda check .vanda/checks/links.toml
stderr 'spec/Task\.tla:13: '
! stderr '(?m)^panic: '
cp orig/Task.tla.orig spec/Task.tla

# sql で決まっていない種類（foo）を書くと、その行で止まる
cp cases/sql-unknown-kind.case db/schema.sql
! exec vanda check .vanda/checks/links.toml
stderr 'db/schema\.sql:1: .*foo'
! stderr '(?m)^panic: '
cp orig/schema.sql.orig db/schema.sql

# sql で 1 つのアノテーションに ID を 2 つ書くと、その行で止まる
cp cases/sql-two-ids.case db/schema.sql
! exec vanda check .vanda/checks/links.toml
stderr 'db/schema\.sql:1: '
! stderr '(?m)^panic: '
cp orig/schema.sql.orig db/schema.sql

# Go で型の宣言の前に書くと止まる
cp cases/go-on-type.case task.go
! exec vanda check .vanda/checks/links.toml
stderr 'task\.go:3: '
! stderr '(?m)^panic: '
cp orig/task.go.orig task.go

# Go で関数の中に書くと止まる
cp cases/go-in-body.case task.go
! exec vanda check .vanda/checks/links.toml
stderr 'task\.go:7: '
! stderr '(?m)^panic: '
cp orig/task.go.orig task.go

# Go でコメントと func の宣言のあいだに空行があると止まる
cp cases/go-gap.case task.go
! exec vanda check .vanda/checks/links.toml
stderr 'task\.go:6: '
! stderr '(?m)^panic: '
cp orig/task.go.orig task.go

# Go でメソッドの宣言の直前に書けば通る
cp cases/go-method.case task.go
exec vanda check .vanda/checks/links.toml
cp orig/task.go.orig task.go

# txtar で最初の -- name -- より後の `@vanda:` は数えず、誤りにもしない
cp cases/txtar-after.case scenarios/add.txtar
unquote scenarios/add.txtar
exec vanda check .vanda/checks/links.toml
cp orig/add.txtar.orig scenarios/add.txtar
unquote scenarios/add.txtar

# Go の文字列の中の `@vanda:` は数えず、誤りにもしない
cp cases/go-string.case task.go
exec vanda check .vanda/checks/links.toml
cp orig/task.go.orig task.go

# TLA+ の文字列の中の `@vanda:` は数えず、誤りにもしない
cp cases/tla-string.case spec/Task.tla
exec vanda check .vanda/checks/links.toml
cp orig/Task.tla.orig spec/Task.tla

# SQL の文字列の中の `@vanda:` は数えず、誤りにもしない
cp cases/sql-string.case db/schema.sql
exec vanda check .vanda/checks/links.toml
cp orig/schema.sql.orig db/schema.sql

# コメントの中で逆引用符で囲んだ `@vanda:` は数えず、誤りにもしない（説明の文で書き方に触れるため）。4 つの言語の全部で回す
cp cases/go-backquote.case task.go
exec vanda check .vanda/checks/links.toml
cp orig/task.go.orig task.go
cp cases/txtar-backquote.case scenarios/add.txtar
unquote scenarios/add.txtar
exec vanda check .vanda/checks/links.toml
cp orig/add.txtar.orig scenarios/add.txtar
unquote scenarios/add.txtar
cp cases/tla-backquote.case spec/Task.tla
exec vanda check .vanda/checks/links.toml
cp orig/Task.tla.orig spec/Task.tla
cp cases/sql-backquote.case db/schema.sql
exec vanda check .vanda/checks/links.toml
cp orig/schema.sql.orig db/schema.sql

# 逆引用符で囲まなければ、同じ所でも数える（上の確かめが、ただ読み飛ばしているのでないことを見るため）
cp cases/go-backquote-off.case task.go
! exec vanda check .vanda/checks/links.toml
stderr 'task\.go:3: '
! stderr '(?m)^panic: '
cp orig/task.go.orig task.go

# 逆引用符で囲んだ `@vanda:` は、1 行に 2 つ以上あるかを見るときも数えない
cp cases/tla-backquote-same-line.case spec/Task.tla
exec vanda check .vanda/checks/links.toml
cp orig/Task.tla.orig spec/Task.tla

# txtar で、最初の -- name -- より前でも、# で始まらない命令の行の `@vanda:` は数えない
cp cases/txtar-command.case scenarios/add.txtar
unquote scenarios/add.txtar
exec vanda check .vanda/checks/links.toml
cp orig/add.txtar.orig scenarios/add.txtar
unquote scenarios/add.txtar

# TLA+ で次の行が定義でない（VARIABLES）と止まる
cp cases/tla-vars.case spec/Task.tla
! exec vanda check .vanda/checks/links.toml
stderr 'spec/Task\.tla:8: '
! stderr '(?m)^panic: '
cp orig/Task.tla.orig spec/Task.tla

# TLA+ でアノテーションと定義のあいだに空行とコメントがあっても通る
cp cases/tla-gap.case spec/Task.tla
exec vanda check .vanda/checks/links.toml
cp orig/Task.tla.orig spec/Task.tla

# go でID のないアノテーションを書くと、その行で止まる
cp cases/go-no-id.case task.go
! exec vanda check .vanda/checks/links.toml
stderr 'task\.go:6: '
! stderr '(?m)^panic: '
cp orig/task.go.orig task.go

# go で理由のない internal のアノテーションを書くと、その行で止まる
cp cases/go-internal-no-reason.case task.go
! exec vanda check .vanda/checks/links.toml
stderr 'task\.go:6: '
! stderr '(?m)^panic: '
cp orig/task.go.orig task.go

# go で1 行に 2 つのアノテーションを書くと、その行で止まる
cp cases/go-two-on-line.case task.go
! exec vanda check .vanda/checks/links.toml
stderr 'task\.go:6: '
! stderr '(?m)^panic: '
cp orig/task.go.orig task.go

# txtar でID のないアノテーションを書くと、その行で止まる
cp cases/txtar-no-id.case scenarios/add.txtar
unquote scenarios/add.txtar
! exec vanda check .vanda/checks/links.toml
stderr 'scenarios/add\.txtar:1: '
! stderr '(?m)^panic: '
cp orig/add.txtar.orig scenarios/add.txtar
unquote scenarios/add.txtar

# txtar で理由のない internal のアノテーションを書くと、その行で止まる
cp cases/txtar-internal-no-reason.case scenarios/add.txtar
unquote scenarios/add.txtar
! exec vanda check .vanda/checks/links.toml
stderr 'scenarios/add\.txtar:1: '
! stderr '(?m)^panic: '
cp orig/add.txtar.orig scenarios/add.txtar
unquote scenarios/add.txtar

# txtar で1 行に 2 つのアノテーションを書くと、その行で止まる
cp cases/txtar-two-on-line.case scenarios/add.txtar
unquote scenarios/add.txtar
! exec vanda check .vanda/checks/links.toml
stderr 'scenarios/add\.txtar:1: '
! stderr '(?m)^panic: '
cp orig/add.txtar.orig scenarios/add.txtar
unquote scenarios/add.txtar

# tla でID のないアノテーションを書くと、その行で止まる
cp cases/tla-no-id.case spec/Task.tla
! exec vanda check .vanda/checks/links.toml
stderr 'spec/Task\.tla:13: '
! stderr '(?m)^panic: '
cp orig/Task.tla.orig spec/Task.tla

# tla で理由のない internal のアノテーションを書くと、その行で止まる
