# アノテーションの読み取り: 決まっていない種類と、ID を 2 つ以上書いたものは、どの言語でもその行で止まる。
# 付ける所の決まり: Go は func の宣言の直前のコメントだけ。txtar は最初の -- name -- より前だけ。
# TLA+ は、次の空行でもコメントでもない行が Name == か Name(...) == でなければ止まる。

exec git init -q -b main
expand .vanda/config.toml
unquote scenarios/add.txtar

# 元のファイルでは通る
exec vanda check .vanda/checks/links.toml

# go で決まっていない種類（foo）を書くと、その行で止まる
cp cases/go-unknown-kind.case task.go
! exec vanda check .vanda/checks/links.toml
stderr 'task\.go:6: .*foo'
! stderr '(?m)^panic: '
cp orig/task.go.orig task.go

# go で 1 つのアノテーションに ID を 2 つ書くと、その行で止まる
cp cases/go-two-ids.case task.go
! exec vanda check .vanda/checks/links.toml
stderr 'task\.go:6: '
! stderr '(?m)^panic: '
cp orig/task.go.orig task.go

# txtar で決まっていない種類（foo）を書くと、その行で止まる
cp cases/txtar-unknown-kind.case scenarios/add.txtar
unquote scenarios/add.txtar
! exec vanda check .vanda/checks/links.toml
stderr 'scenarios/add\.txtar:1: .*foo'
! stderr '(?m)^panic: '
cp orig/add.txtar.orig scenarios/add.txtar
unquote scenarios/add.txtar

# txtar で 1 つのアノテーションに ID を 2 つ書くと、その行で止まる
cp cases/txtar-two-ids.case scenarios/add.txtar
unquote scenarios/add.txtar
! exec vanda check .vanda/checks/links.toml
stderr 'scenarios/add\.txtar:1: '
! stderr '(?m)^panic: '
cp orig/add.txtar.orig scenarios/add.txtar
unquote scenarios/add.txtar

# tla で決まっていない種類（foo）を書くと、その行で止まる
cp cases/tla-unknown-kind.case spec/Task.tla
! exec vanda check .vanda/checks/links.toml
stderr 'spec/Task\.tla:13: .*foo'
! stderr '(?m)^panic: '
cp orig/Task.tla.orig spec/Task.tla

# tla で 1 つのアノテーションに ID を 2 つ書くと、その行で止まる
cp cases/tla-two-ids.case spec/Task.tla
! exec vanda check .vanda/checks/links.toml
stderr 'spec/Task\.tla:13: '
! stderr '(?m)^panic: '
cp orig/Task.tla.orig spec/Task.tla

# sql で決まっていない種類（foo）を書くと、その行で止まる
cp cases/sql-unknown-kind.case db/schema.sql
! exec vanda check .vanda/checks/links.toml
stderr 'db/schema\.sql:1: .*foo'
! stderr '(?m)^panic: '
cp orig/schema.sql.orig db/schema.sql

# sql で 1 つのアノテーションに ID を 2 つ書くと、その行で止まる
cp cases/sql-two-ids.case db/schema.sql
! exec vanda check .vanda/checks/links.toml
stderr 'db/schema\.sql:1: '
! stderr '(?m)^panic: '
cp orig/schema.sql.orig db/schema.sql

# Go で型の宣言の前に書くと止まる
cp cases/go-on-type.case task.go
! exec vanda check .vanda/checks/links.toml
stderr 'task\.go:3: '
! stderr '(?m)^panic: '
cp orig/task.go.orig task.go

# Go で関数の中に書くと止まる
cp cases/go-in-body.case task.go
! exec vanda check .vanda/checks/links.toml
stderr 'task\.go:7: '
! stderr '(?m)^panic: '
cp orig/task.go.orig task.go

# Go でコメントと func の宣言のあいだに空行があると止まる
cp cases/go-gap.case task.go
! exec vanda check .vanda/checks/links.toml
stderr 'task\.go:6: '
! stderr '(?m)^panic: '
cp orig/task.go.orig task.go

# Go でメソッドの宣言の直前に書けば通る
cp cases/go-method.case task.go
exec vanda check .vanda/checks/links.toml
cp orig/task.go.orig task.go

# txtar で最初の -- name -- より後に書くと止まる
cp cases/txtar-after.case scenarios/add.txtar
unquote scenarios/add.txtar
! exec vanda check .vanda/checks/links.toml
stderr 'scenarios/add\.txtar:3: '
! stderr '(?m)^panic: '
cp orig/add.txtar.orig scenarios/add.txtar
unquote scenarios/add.txtar

# TLA+ で次の行が定義でない（VARIABLES）と止まる
cp cases/tla-vars.case spec/Task.tla
! exec vanda check .vanda/checks/links.toml
stderr 'spec/Task\.tla:8: '
! stderr '(?m)^panic: '
cp orig/Task.tla.orig spec/Task.tla

# TLA+ でアノテーションと定義のあいだに空行とコメントがあっても通る
cp cases/tla-gap.case spec/Task.tla
exec vanda check .vanda/checks/links.toml
cp orig/Task.tla.orig spec/Task.tla

-- .vanda/config.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"

[[annotation]]
paths = ["**/*.go"]
adapter = "go"

[[annotation]]
paths = ["scenarios/**/*.txtar"]
adapter = "txtar"

[[annotation]]
paths = ["spec/**/*.tla"]
adapter = "tla"

[[annotation]]
paths = ["db/**/*.sql"]
adapter = "sql"
-- .vanda/checks/links.toml --
[[check]]
name = "annotation-links"
scope = "all"
-- .vanda/agreements.toml --
-- .vanda/promises.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"

[[feature]]
id = "task-add"
name = "タスクの登録"
definition = "タスクを足す"

[[claim]]
id = "task-id-unique"
subjects = ["task", "task-add"]
statement = "タスクの ID は重ならない"
layers = ["model"]

[[claim.evidence]]
stage = "test"
type = "unit-test"
layers = ["model"]
-- task.go --
package task

// Task は利用者がやること。
type Task struct{ ID string }

// @vanda:sensor task-id-unique
func Add(ids []string, id string) ([]string, error) { return append(ids, id), nil }
-- task_test.go --
package task

import "testing"

// @vanda:evidence task-id-unique
func TestAddKeepsIdsUnique(t *testing.T) {}
-- scenarios/add.txtar --
># @vanda:evidence task-id-unique
>exec echo add
>-- out.txt --
>add
-- spec/Task.tla --
---- MODULE Task ----
\* @vanda:term task
TaskIds == {"t1", "t2"}

(* @vanda:internal 検査のための小さな数の集合 *)
Small == {0, 1, 2}

VARIABLES tasks, n

\* @vanda:claim task-id-unique
TypeOK == tasks \subseteq TaskIds /\ n \in Small

\* @vanda:feature task-add
Add(t) == tasks' = tasks \cup {t} /\ n' = n + 1
====
-- db/schema.sql --
-- @vanda:evidence task-id-unique
CREATE TABLE task (id TEXT PRIMARY KEY);
-- orig/task.go.orig --
package task

// Task は利用者がやること。
type Task struct{ ID string }

// @vanda:sensor task-id-unique
func Add(ids []string, id string) ([]string, error) { return append(ids, id), nil }
-- orig/task_test.go.orig --
package task

import "testing"

// @vanda:evidence task-id-unique
func TestAddKeepsIdsUnique(t *testing.T) {}
-- orig/add.txtar.orig --
># @vanda:evidence task-id-unique
>exec echo add
>-- out.txt --
>add
-- orig/Task.tla.orig --
---- MODULE Task ----
\* @vanda:term task
TaskIds == {"t1", "t2"}

(* @vanda:internal 検査のための小さな数の集合 *)
Small == {0, 1, 2}

VARIABLES tasks, n

\* @vanda:claim task-id-unique
TypeOK == tasks \subseteq TaskIds /\ n \in Small

\* @vanda:feature task-add
Add(t) == tasks' = tasks \cup {t} /\ n' = n + 1
====
-- orig/schema.sql.orig --
-- @vanda:evidence task-id-unique
