# TLA+ の (* *) で同じ行に閉じても、閉じは ID に含めないので通る
cp cases/tla-block-ok.case spec/Task.tla
exec vanda check .vanda/checks/links.toml
cp orig/Task.tla.orig spec/Task.tla

# TLA+ で LOCAL の付いた定義に付けても通る
cp cases/tla-local.case spec/Task.tla
exec vanda check .vanda/checks/links.toml
