layers = ["model"]
model_check_waiver = "登録の順で結果が変わらないため"

[[claim.evidence]]
stage = "implementation"
type = "unit-test"
layers = ["model"]

[[claim.evidence]]
stage = "implementation"
type = "model-check"
layers = ["model"]
