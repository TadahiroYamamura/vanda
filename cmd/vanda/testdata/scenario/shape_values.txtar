# CMD-10 約束リストの形: ステージ・タイプ・レイヤーが決まった値の中にある。flags は ai-proposal だけ。
# @vanda:evidence promise-list-layers-known
# @vanda:evidence promise-list-fixed-values
# 決まった値は全部を使って通ることを、決まった値の外の値は止まることを確かめる。
# 決まった値の一覧は約束 promise-list-fixed-value-list の文のとおり。

exec git init -q -b main
expand .vanda/config.toml

# 11 のタイプ、4 つのステージ、設定にある 3 つのレイヤー、flags の ai-proposal と guesses を使えば通る
cp cases/all-values.toml .vanda/promises.toml
commit '(test) 審査の前にコミットする'
exec vanda check .vanda/checks/shape.toml

# 決まった値にないステージ
cp cases/bad-stage.toml .vanda/promises.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:21: .*testing'
! stderr '(?m)^panic: '

# 決まった値から外したステージ test
cp cases/removed-stage.toml .vanda/promises.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:21: .*\Wtest\W'
! stderr '(?m)^panic: '

# 決まった値から外したタイプ monitoring
cp cases/removed-type.toml .vanda/promises.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:22: .*monitoring'
! stderr '(?m)^panic: '

# 決まった値にないタイプ
cp cases/bad-type.toml .vanda/promises.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:22: .*e2e-test'
! stderr '(?m)^panic: '

# 約束に、設定にないレイヤー
cp cases/bad-claim-layer.toml .vanda/promises.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:18: .*ui'
! stderr '(?m)^panic: '

# エビデンスに、設定にないレイヤー
cp cases/bad-evidence-layer.toml .vanda/promises.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:23: .*ui'
! stderr '(?m)^panic: '

# flags に ai-proposal 以外の値
cp cases/bad-flags.toml .vanda/promises.toml
commit '(test) 審査の前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'promises\.toml:19: .*guess'
! stderr '(?m)^panic: '

-- .vanda/config.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"

[[layer]]
id = "cli"
name = "CLI"
description = "引数と出力の形"

[[layer]]
id = "db"
name = "DB"
description = "保存"
-- .vanda/checks/shape.toml --
[[check]]
name = "promise-list-shape"
scope = "all"
-- .vanda/agreements.toml --
-- .vanda/promises.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"

[[feature]]
id = "task-add"
name = "タスクの登録"
definition = "タスクを足す"
core = false

[[claim]]
id = "task-id-unique"
subjects = ["task", "task-add"]
statement = "タスクの ID は重ならない"
rationale = "ID でタスクを指すため"
condition = "いつも"
layers = ["model"]

[[claim.evidence]]
stage = "implementation"
type = "unit-test"
layers = ["model"]
detail = "task_test.go"
-- cases/all-values.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"

[[feature]]
id = "task-add"
name = "タスクの登録"
definition = "タスクを足す"
core = false

[[claim]]
id = "task-id-unique"
subjects = ["task", "task-add"]
statement = "タスクの ID は重ならない"
rationale = "ID でタスクを指すため"
condition = "いつも"
layers = ["model", "cli", "db"]
flags = ["ai-proposal"]
guesses = ["ID は登録の順に振られる"]

[[claim.evidence]]
stage = "plan"
type = "model-check"
layers = ["model"]
detail = "evidence-0"

[[claim.evidence]]
stage = "implementation"
type = "proof"
layers = ["cli"]
detail = "evidence-1"

[[claim.evidence]]
stage = "release"
type = "cross-check"
layers = ["db"]
detail = "evidence-2"

[[claim.evidence]]
stage = "operation"
type = "random-check"
layers = ["model"]
detail = "evidence-3"

[[claim.evidence]]
stage = "plan"
type = "scenario-test"
layers = ["cli"]
detail = "evidence-4"

[[claim.evidence]]
stage = "implementation"
type = "unit-test"
layers = ["db"]
detail = "evidence-5"

[[claim.evidence]]
stage = "release"
type = "interface-test"
layers = ["model"]
detail = "evidence-6"

[[claim.evidence]]
stage = "operation"
type = "concurrency-test"
layers = ["cli"]
detail = "evidence-7"

[[claim.evidence]]
stage = "plan"
type = "guardrail"
layers = ["db"]
detail = "evidence-8"

[[claim.evidence]]
stage = "implementation"
type = "sensor"
layers = ["model"]
detail = "evidence-9"

[[claim.evidence]]
stage = "release"
type = "human-review"
layers = ["cli"]
detail = "evidence-10"
