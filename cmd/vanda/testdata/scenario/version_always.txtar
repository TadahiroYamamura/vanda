# CMD-01: vanda version は、.vanda/ がなくても、設定のバージョンが合わなくても、動いている vanda のバージョンを 1 行で出す。
# @vanda:evidence version-always-runs
# バージョンの値は、テストの外で読んだ動いている vanda のバージョン（VANDA_VERSION）と比べる（バージョンの中の . は、どの文字にもマッチする）。

# git のリポジトリの外で、.vanda/ もない
exec vanda version
stdout ^v?${VANDA_VERSION}\n$
! stderr .

# git のリポジトリの中で、.vanda/ がない
exec git init -q -b main
exec vanda version
stdout ^v?${VANDA_VERSION}\n$

# 設定のバージョンが新しい・古い（vanda check と vanda doctor は止まる）
mkdir .vanda
expand cases/newer.toml
cp cases/newer.toml .vanda/config.toml
! exec vanda doctor
exec vanda version
stdout ^v?${VANDA_VERSION}\n$
expand cases/older.toml
cp cases/older.toml .vanda/config.toml
! exec vanda doctor
exec vanda version
stdout ^v?${VANDA_VERSION}\n$

-- cases/newer.toml --
version = "${VANDA_VERSION_NEWER}"
-- cases/older.toml --
version = "${VANDA_VERSION_OLDER}"
