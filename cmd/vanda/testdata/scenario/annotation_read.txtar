-- .vanda/config.toml --
version = "${VANDA_VERSION}"

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"

[[annotation]]
paths = ["**/*.go"]
adapter = "go"
types = ["unit-test", "cross-check", "random-check", "interface-test", "concurrency-test", "sensor"]
[[annotation]]
paths = ["scenarios/**/*.txtar"]
adapter = "txtar"
types = ["scenario-test"]
[[annotation]]
paths = ["spec/**/*.tla"]
adapter = "tla"
types = ["model-check"]
[[annotation]]
paths = ["db/**/*.sql"]
adapter = "sql"
types = ["guardrail"]
-- .vanda/checks/links.toml --
[[check]]
name = "annotation-links"
scope = "all"
-- .vanda/agreements.toml --
-- .vanda/promises.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"

[[feature]]
id = "task-add"
name = "タスクの登録"
definition = "タスクを足す"

[[claim]]
id = "task-id-unique"
subjects = ["task", "task-add"]
statement = "タスクの ID は重ならない"
layers = ["model"]

[[claim.evidence]]
stage = "test"
type = "unit-test"
layers = ["model"]
-- task.go --
package task

// Task は利用者がやること。
type Task struct{ ID string }

// @vanda:sensor task-id-unique
func Add(ids []string, id string) ([]string, error) { return append(ids, id), nil }
-- task_test.go --
package task

import "testing"

// @vanda:evidence task-id-unique
func TestAddKeepsIdsUnique(t *testing.T) {}
-- scenarios/add.txtar --
># @vanda:evidence task-id-unique
>exec echo add
>-- out.txt --
>add
-- spec/Task.tla --
---- MODULE Task ----
\* @vanda:term task
TaskIds == {"t1", "t2"}

(* @vanda:internal 検査のための小さな数の集合 *)
Small == {0, 1, 2}

VARIABLES tasks, n

\* @vanda:claim task-id-unique
TypeOK == tasks \subseteq TaskIds /\ n \in Small

\* @vanda:feature task-add
Add(t) == tasks' = tasks \cup {t} /\ n' = n + 1
====
-- db/schema.sql --
-- @vanda:evidence task-id-unique
CREATE TABLE task (id TEXT PRIMARY KEY);
-- orig/task.go.orig --
package task

// Task は利用者がやること。
type Task struct{ ID string }

// @vanda:sensor task-id-unique
func Add(ids []string, id string) ([]string, error) { return append(ids, id), nil }
-- orig/task_test.go.orig --
package task

import "testing"

// @vanda:evidence task-id-unique
func TestAddKeepsIdsUnique(t *testing.T) {}
-- orig/add.txtar.orig --
># @vanda:evidence task-id-unique
>exec echo add
>-- out.txt --
>add
-- orig/Task.tla.orig --
