# アノテーションの読み取り: 6 つの種類 × Go・シナリオ（txtar）・TLA+・SQL を全部回す。
# 書ける組み合わせ（Go: evidence・sensor、txtar: evidence、TLA+: term・feature・claim・internal、SQL: evidence）は、
# 約束リストにない ID（no-such-id）を指すと、アノテーションのつながりの審査がその行で止まることで、読んだことを確かめる。
# 書けない組み合わせは、種類に合う ID を書いても、その行で止まる。
#
# TLA+ の internal を読めたことと、付いているものの名前は、単体テスト（internal/annotation）で確かめる。

exec git init -q -b main
expand .vanda/config.toml
unquote scenarios/add.txtar

# 元のファイルでは通る
exec vanda check .vanda/checks/links.toml

# go では `@vanda:term` を書けないので、その行で止まる
cp cases/go-term.case task.go
! exec vanda check .vanda/checks/links.toml
stderr 'task\.go:6: '
! stderr '(?m)^panic: '
cp orig/task.go.orig task.go

# go では `@vanda:feature` を書けないので、その行で止まる
cp cases/go-feature.case task.go
! exec vanda check .vanda/checks/links.toml
stderr 'task\.go:6: '
! stderr '(?m)^panic: '
cp orig/task.go.orig task.go

# go では `@vanda:claim` を書けないので、その行で止まる
cp cases/go-claim.case task.go
! exec vanda check .vanda/checks/links.toml
stderr 'task\.go:6: '
! stderr '(?m)^panic: '
cp orig/task.go.orig task.go

# go では `@vanda:internal` を書けないので、その行で止まる
cp cases/go-internal.case task.go
! exec vanda check .vanda/checks/links.toml
stderr 'task\.go:6: '
! stderr '(?m)^panic: '
cp orig/task.go.orig task.go

# go の `@vanda:evidence` を読む（約束リストにない ID を指すと、その行で止まる）
cp cases/go-evidence.case task.go
! exec vanda check .vanda/checks/links.toml
stderr 'task\.go:6: '
! stderr '(?m)^panic: '
cp orig/task.go.orig task.go

# go の `@vanda:sensor` を読む（約束リストにない ID を指すと、その行で止まる）
cp cases/go-sensor.case task.go
! exec vanda check .vanda/checks/links.toml
stderr 'task\.go:6: '
! stderr '(?m)^panic: '
cp orig/task.go.orig task.go

# txtar では `@vanda:term` を書けないので、その行で止まる
cp cases/txtar-term.case scenarios/add.txtar
unquote scenarios/add.txtar
! exec vanda check .vanda/checks/links.toml
stderr 'scenarios/add\.txtar:1: '
! stderr '(?m)^panic: '
cp orig/add.txtar.orig scenarios/add.txtar
unquote scenarios/add.txtar

# txtar では `@vanda:feature` を書けないので、その行で止まる
cp cases/txtar-feature.case scenarios/add.txtar
unquote scenarios/add.txtar
! exec vanda check .vanda/checks/links.toml
stderr 'scenarios/add\.txtar:1: '
! stderr '(?m)^panic: '
cp orig/add.txtar.orig scenarios/add.txtar
unquote scenarios/add.txtar

# txtar では `@vanda:claim` を書けないので、その行で止まる
cp cases/txtar-claim.case scenarios/add.txtar
unquote scenarios/add.txtar
! exec vanda check .vanda/checks/links.toml
stderr 'scenarios/add\.txtar:1: '
! stderr '(?m)^panic: '
cp orig/add.txtar.orig scenarios/add.txtar
unquote scenarios/add.txtar

# txtar では `@vanda:internal` を書けないので、その行で止まる
cp cases/txtar-internal.case scenarios/add.txtar
unquote scenarios/add.txtar
! exec vanda check .vanda/checks/links.toml
