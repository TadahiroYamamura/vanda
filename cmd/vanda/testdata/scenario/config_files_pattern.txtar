# CM-09: 設定に読むファイルのパターンを書くと、マッチしたファイルを全部読む。
# @vanda:evidence mistakes-reported-with-fix
# パターンを書いたときは、既定のファイル（.vanda/promises.toml）は読まない。

exec git init -q -b main
expand .vanda/config.toml

# a.toml の仕様は b.toml の機能を、b.toml の機能は a.toml の性質を refines する。
# どちらかのファイルを読まなければ、refines の先が見つからずに止まる。
commit '(test) チェックの前にコミットする'
exec vanda check .vanda/checks/shape.toml

# パターンにマッチしたファイルの誤りで止まる
cp cases/b-bad-stage.toml .vanda/promises/b.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/shape.toml
stderr 'b\.toml'
! stderr '(?m)^panic: '

# 承認の記録も、パターンにマッチしたファイルを全部読む。
# 承認した仕様を約束リストから消すと、どちらのファイルの記録でも、約束リストにない仕様を指すようになる。
# このチェックはフィンガープリントが今の中身に合うかを見ないので、フィンガープリントの元の JSON の書き方（日本語の文字の扱い）は結果に関わらない。
cp cases/b.toml .vanda/promises/b.toml
agree .vanda/agreements/x.toml '#1' spec a-spec fp/a-spec.json
agree .vanda/agreements/y.toml '#2' spec b-spec fp/b-spec.json
commit '(test) チェックの前にコミットする'
exec vanda check .vanda/checks/targets.toml
cp cases/b-without-spec.toml .vanda/promises/b.toml
commit '(test) チェックの前にコミットする'
! exec vanda check .vanda/checks/targets.toml
stderr 'y\.toml'
! stderr '(?m)^panic: '

-- .vanda/config.toml --
version = "${VANDA_VERSION}"
promises = [".vanda/promises/*.toml"]
agreements = [".vanda/agreements/*.toml"]

[[layer]]
id = "model"
name = "モデル"
description = "判定と状態の変化"
-- .vanda/checks/shape.toml --
[[check]]
name = "promise-list-shape"
scope = "all"
-- .vanda/checks/targets.toml --
[[check]]
name = "agreement-targets"
scope = "all"
-- .vanda/agreements/x.toml --
-- .vanda/agreements/y.toml --
-- .vanda/promises.toml --
これは TOML として読めない。パターンを書いたので、読まれないはずのファイル。
-- .vanda/promises/a.toml --
[[term]]
id = "task"
name = "タスク"
definition = "利用者がやること"

[[spec]]
id = "a-spec"
refines = ["task-add"]
statement = "登録したタスクは一覧に出る"
rationale = "登録できたかを確かめるため"
condition = "いつも"
layers = ["model"]

[[spec.evidence]]
stage = "implementation"
type = "unit-test"
layers = ["model"]
detail = "task_test.go"

[[property]]
id = "no-lost-task"
statement = "登録したタスクは失われない"
-- .vanda/promises/b.toml --
[[feature]]
id = "task-add"
name = "タスクの登録"
definition = "タスクを足す"
core = false
refines = ["no-lost-task"]

[[spec]]
id = "b-spec"
refines = ["task-add"]
statement = "タスクの ID は重ならない"
rationale = "ID でタスクを指すため"
condition = "いつも"
layers = ["model"]

[[spec.evidence]]
stage = "implementation"
type = "unit-test"
layers = ["model"]
detail = "task_test.go"
-- cases/b.toml --
[[feature]]
id = "task-add"
name = "タスクの登録"
definition = "タスクを足す"
core = false
refines = ["no-lost-task"]

[[spec]]
id = "b-spec"
refines = ["task-add"]
statement = "タスクの ID は重ならない"
rationale = "ID でタスクを指すため"
condition = "いつも"
layers = ["model"]

[[spec.evidence]]
stage = "implementation"
type = "unit-test"
layers = ["model"]
detail = "task_test.go"
-- cases/b-bad-stage.toml --
[[feature]]
id = "task-add"
name = "タスクの登録"
definition = "タスクを足す"
core = false
refines = ["no-lost-task"]

[[spec]]
id = "b-spec"
refines = ["task-add"]
statement = "タスクの ID は重ならない"
rationale = "ID でタスクを指すため"
condition = "いつも"
layers = ["model"]

[[spec.evidence]]
stage = "no-such-stage"
type = "unit-test"
layers = ["model"]
detail = "task_test.go"
-- cases/b-without-spec.toml --
[[feature]]
id = "task-add"
name = "タスクの登録"
definition = "タスクを足す"
core = false
refines = ["no-lost-task"]
-- fp/a-spec.json --
{"condition":"いつも","evidence":[{"detail":"task_test.go","layers":["model"],"stage":"implementation","type":"unit-test"}],"id":"a-spec","layers":["model"],"rationale":"登録できたかを確かめるため","statement":"登録したタスクは一覧に出る","subjects":["task-add"]}
-- fp/b-spec.json --
{"condition":"いつも","evidence":[{"detail":"task_test.go","layers":["model"],"stage":"implementation","type":"unit-test"}],"id":"b-spec","layers":["model"],"rationale":"ID でタスクを指すため","statement":"タスクの ID は重ならない","subjects":["task"]}
